// ─── AUTH MODELS ───────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  emailVerified        DateTime?
  /// Source of truth for the person's name.
  firstName            String?
  lastName             String?
  /// Derived from firstName + lastName on every write.
  ///
  /// Kept because NextAuth's `session.user.name` is part of the adapter
  /// contract and is read in roughly seventy places; removing it would mean
  /// reworking authentication to change a display string. Never write this
  /// directly — use the helpers in lib/person-name.ts.
  name                 String?
  image                String?
  password             String?
  role                 Role      @default(EMPLOYEE)
  isActive             Boolean   @default(true)
  loginAttempts        Int       @default(0)
  lockedUntil          DateTime?
  mustChangePassword   Boolean   @default(false)
  // When the password was last set. Drives the 90-day rotation policy; null
  // means untracked, which is deliberately treated as not-expired so a
  // bookkeeping gap can never lock someone out.
  passwordChangedAt    DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  /// Soft delete. The account is unusable immediately; the row is retained for
  /// 30 days so it can be restored, then anonymised by the purge job.
  deletedAt DateTime?

  /// This login is not a person — a break-glass or integration credential.
  ///
  /// Such accounts must never gain an Employee record: they would inflate
  /// headcount, accrue leave nobody can take, and appear in assignee pickers.
  /// Flagging them also stops HR nagging forever about a missing employee
  /// record that should never exist.
  isServiceAccount Boolean @default(false)

  /// Any session issued before this instant is refused.
  ///
  /// Sessions are stateless JWTs, so there is nothing server-side to destroy.
  /// Bumping this on deactivate or delete is what makes those take effect on
  /// the user's very next request instead of whenever their token happens to
  /// expire — which was up to 48 hours.
  sessionsRevokedAt DateTime?

  /// Set when the 30-day window has passed and personal data was stripped.
  ///
  /// The row itself survives on purpose: nine foreign keys point at users with
  /// ON DELETE RESTRICT on NOT NULL columns — leads.createdById,
  /// employees.userId, monthly_reports.icrId among them. Deleting the row would
  /// either fail outright or, if those were relaxed, take business records with
  /// it. Anonymising removes the person while leaving the company's history
  /// attributable and intact.
  purgedAt DateTime?

  regionId            String?
  region              Region?              @relation(fields: [regionId], references: [id])
  employee            Employee?
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  passwordHistory     PasswordHistory[]

  assignedLeads     Lead[]            @relation("AssignedICR")
  assignedInterests InstitutionInterest[] @relation("InterestAssignedICR")

  // ─── Redesign back-refs (Phase 4–7) ─────────────────────────────────────
  managedMarkets      Market[]                 @relation("MarketRegionalManager")
  submittedUpdates    MarketUpdateSuggestion[] @relation("MarketUpdateSubmitter")
  reviewedUpdates     MarketUpdateSuggestion[] @relation("MarketUpdateReviewer")
  ownedPlans          QuarterlyRecruitmentPlan[] @relation("PlanICR")
  regionalReviewedPlans QuarterlyRecruitmentPlan[] @relation("PlanRegionalManager")
  accountReviewedPlans  QuarterlyRecruitmentPlan[] @relation("PlanAccountManager")
  vpReviewedPlans       QuarterlyRecruitmentPlan[] @relation("PlanVpReviewer")
  transitionsOutgoing   TransitionReport[]       @relation("TransitionOutgoingICR")
  transitionsIncoming   TransitionReport[]       @relation("TransitionIncomingICR")
  transitionsManaged    TransitionReport[]       @relation("TransitionRegionalManager")
  transitionsClientRel  TransitionReport[]       @relation("TransitionClientRelations")
  transitionsVpSales    TransitionReport[]       @relation("TransitionVpGlobalSales")
  transitionsCreated    TransitionReport[]       @relation("TransitionCreatedBy")
  transitionEvents      TransitionWorkflowEvent[]
  forecastsOwned        Forecast[]               @relation("ForecastICR")
  forecastsManaged      Forecast[]               @relation("ForecastRM")
  forecastsVpReviewed   Forecast[]               @relation("ForecastVP")
  forecastsCreated      Forecast[]               @relation("ForecastCreatedBy")
  forecastEvents        ForecastEvent[]
  requestedVariations VariationRequest[]       @relation("VariationRequester")
  approvedVariations  VariationRequest[]       @relation("VariationApprover")
  eventParticipations EventParticipation[]     @relation("EventParticipationICR")
  createdLeads      Lead[]            @relation("LeadCreatedBy")
  leadActivities    LeadActivity[]
  assignedEvents    Event[]
  monthlyReports    MonthlyReport[]   @relation("ICRReports")
  icrMonthlyReports IcrMonthlyReport[] @relation("ICRMonthlyReports")
  weeklyActivities  WeeklyActivity[]  @relation("ICRWeeklyActivities")
  reportApprovals   ReportApproval[]
  icrReportApprovals IcrReportApproval[]
  engagementLogs    EngagementLog[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  accountRequests   AccountRequest[]  @relation("AccountRequestRequester")
  reviewedRequests  AccountRequest[]  @relation("AccountRequestReviewer")
  offboardingRequests        OffboardingRequest[] @relation("OffboardingRequestRequester")
  reviewedOffboardingRequests OffboardingRequest[] @relation("OffboardingRequestReviewer")
  institutionAccess InstitutionUser[]
  whatsappMessages  WhatsAppMessage[]

  // Phase 1 relations
  managedInstitutions Institution[]    @relation("AccountManager")
  regionalInstitutions Institution[]   @relation("InstitutionRegionalManager")
  activities          Activity[]

  // Phase 5 — Clients spec closure back-refs
  ownedIssues         ClientIssue[]    @relation("IssueOwner")
  interventions       AccountIntervention[] @relation("InterventionOwner")
  ownedContracts      Contract[]       @relation("ContractOwner")
  ownedContacts       InstitutionContact[] @relation("ContactOwner")

  // Phase 5/6 — Recruitment Network + Field Ops back-refs
  ownedCampaigns      Campaign[]       @relation("CampaignOwner")
  followUpActivities  Activity[]       @relation("ActivityFollowUpAssignee")
  ownedRisks          RiskRegister[]
  assignedCompliance  ComplianceItem[]

  // Phase 8 — polymorphic attachments (spec §20 doc handling; migration 022)
  uploadedAttachments Attachment[]     @relation("AttachmentUploader")
  deletedAttachments  Attachment[]     @relation("AttachmentDeleter")

  // Phase 9 — recycle bin (migration 023)
  deletedRecords          DeletedRecord[] @relation("DeletedRecordDeleter")
  restoredDeletedRecords  DeletedRecord[] @relation("DeletedRecordRestorer")

  @@index([deletedAt, purgedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // bcrypt hash of a password this user has previously used. Never a plaintext
  // and never reversible — this exists only to answer "have you used this
  // before", which needs a comparison, not a lookup.
  hash      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("password_history")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── CORE GEOGRAPHY ────────────────────────────────────────────────────────

/// Which regions a client is actually worked in.
///
/// `Institution.regionId` holds ONE region and is kept as the primary — the
/// dashboard geo filter, analytics and reporting all read it, and changing that
/// would be a far wider change than this. But a client is rarely worked in one
/// region: of the 39 in the first client list, 24 span several and one spans
/// all six. Storing only the primary threw the rest away silently.
///
/// So this is the full picture and `regionId` is the headline. Keep them
/// consistent: the primary should always also appear here.
model InstitutionRegion {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  regionId      String
  region        Region      @relation(fields: [regionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  /// One row per pairing. Re-importing a client must not duplicate its regions.
  @@unique([institutionId, regionId])
  @@index([regionId])
  @@map("institution_regions")
}

model Region {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  leads            Lead[]
  // Renamed from Source[] to RecruitmentPartner[]. Kept field name `sources`
  // so existing readers (e.g. `region.sources.map(...)`) don't break; only
  // the type behind it changed.
  sources          RecruitmentPartner[]
  events           Event[]
  institutions     Institution[]
  /// Clients worked in this region, including those whose PRIMARY region is
  /// another one — see InstitutionRegion.
  institutionRegions InstitutionRegion[]
  monthlyReports   MonthlyReport[]
  icrMonthlyReports IcrMonthlyReport[]
  weeklyActivities WeeklyActivity[]
  holidays         Holiday[]
  accountRequests  AccountRequest[]
  transitionReports TransitionReport[]
  /// IT equipment sitting in this region — see ITAsset.regionId.
  itAssets         ITAsset[]

  @@map("regions")
}

// ─── PILLAR 1: STUDENT LEADS ───────────────────────────────────────────────

model Lead {
  id                 String     @id @default(uuid())
  /// Names are stored split because university applications ask for given and
  /// family name separately, and a single field cannot be reliably divided
  /// afterwards — roughly a third of this pipeline's names are not two words.
  firstName          String
  lastName           String
  /// Both an email AND a phone are required to create a lead, and neither can
  /// be cleared afterwards — the update schema refuses null and "". The column
  /// stays nullable only because tightening it to NOT NULL would need a
  /// migration and buys nothing while the API is the sole writer.
  ///
  /// Dedup must still skip blank values: matching on an empty string would make
  /// every blank-email lead a duplicate of every other.
  email              String?
  phone              String?
  /// Citizenship, in pipeline terms. Distinct from countryOfResidence.
  nationality        String
  countryOfResidence String
  /// Spec §2 — used by duplicate detection ("Before creating a new Student
  /// Profile, the CRM should search existing Student Profiles using: Email,
  /// Mobile number, Full name, Date of birth, where available"). Nullable
  /// because event capture often can't collect it at the booth.
  dateOfBirth        DateTime?
  /// Spec §2 — passport number is the strongest identity signal (a
  /// government-issued unique key). Nullable because most walk-ins won't
  /// provide it, but where present it's the primary dedup key.
  passportNumber     String?
  interestedProgram  String
  faculty            String?
  studyLevel         StudyLevel
  intakeYear         Int
  intakeMonth        Int
  notes              String?    @db.Text
  stage              LeadStage  @default(NEW_LEAD)
  isDuplicate        Boolean    @default(false)
  duplicateOfId      String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  createdById        String
  lastContactedAt    DateTime?
  lastProgressedAt   DateTime?

  // ─── Pipeline mechanics ─────────────────────────────────────────────────
  /// When the lead entered its current stage. Load-bearing for correctness,
  /// not just the "Days in Current Stage" badge: the gate only counts
  /// activities completed at or after this instant, which is what stops a
  /// re-entered, reopened or reversed stage from being satisfied by stale work.
  stageEnteredAt         DateTime   @default(now())
  /// Stage the lead occupied before being closed. Preserves "where do we lose
  /// students" even though closed outcomes overwrite `stage`.
  stageBeforeClose       LeadStage?
  inactivity14NotifiedAt DateTime?
  inactivity21NotifiedAt DateTime?

  // ─── Stage 1: New Lead ──────────────────────────────────────────────────
  intendedDestination String?
  /// Response-time SLA, started at capture and closed at first contact.
  firstResponseDueAt  DateTime?
  firstContactAt      DateTime?
  responseTimeMinutes Int?

  // ─── Stage 2: Contacted ─────────────────────────────────────────────────
  preferredCountry     String?
  budgetRange          BudgetRange?
  currentQualification String?
  /// Free-text explanation from the ICR. Kept alongside the new enum
  /// `counsellingOutcomeEnum` because "how did the call go" still needs colour
  /// beyond the seven categorical values.
  counsellingOutcome   String?      @db.Text
  /// Spec §5 — categorical counselling outcome. The Contacted → Qualified gate
  /// now checks this instead of just "any text was entered".
  counsellingOutcomeEnum CounsellingOutcome?

  // ─── Stage 3: Qualified ─────────────────────────────────────────────────
  academicQualification  String?
  englishStatus          EnglishStatus?
  eligibilityConfirmedAt DateTime?

  // ─── Stage 8: Enrolled ──────────────────────────────────────────────────
  enrolmentDate      DateTime?
  isConverted        Boolean   @default(false)
  commissionEligible Boolean   @default(false)
  convertedAt        DateTime?

  // ─── Closed outcomes ────────────────────────────────────────────────────
  lostReason          LeadLostReason?
  lostDate            DateTime?
  lostNotes           String?         @db.Text
  deferredIntakeYear  Int?
  deferredIntakeMonth Int?
  deferredReason      String?         @db.Text
  deferredFollowUpAt  DateTime?
  /// Stored at close rather than recomputed, so the reopen date is inspectable.
  deferredReopenAt    DateTime?

  /// Spec §15 (migration 027) — student withdrew from the process. Distinct
  /// from LOST: there was no competitive loss, the student pulled out.
  withdrawnReason     String?         @db.Text
  withdrawnNotes      String?         @db.Text
  withdrawnDate       DateTime?

  /// Spec §15 (migration 027) — visa refused. Deliberately NOT folded into
  /// `lostReason = VISA`, which means "lost, and visa difficulty was why".
  /// A refusal is a decision on a specific application and can be reapplied
  /// for, so it needs its own date and reason to answer "what is our visa
  /// refusal rate" separately from "who did we lose".
  visaRefusalDate     DateTime?
  visaRefusalReason   String?         @db.Text
  /// Three-valued: NULL = not asked, false = not reapplying, true = reapplying.
  /// Same rationale as `marketingConsent` — defaulting to false would record an
  /// answer nobody gave.
  visaReapplying      Boolean?

  regionId      String?
  region        Region?      @relation(fields: [regionId], references: [id])
  assignedICRId String?
  assignedICR   User?        @relation("AssignedICR", fields: [assignedICRId], references: [id])
  createdBy     User         @relation("LeadCreatedBy", fields: [createdById], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  sourceId      String?
  source        RecruitmentPartner? @relation(fields: [sourceId], references: [id])
  eventId       String?
  event         Event?       @relation(fields: [eventId], references: [id])

  /// Spec §16 — the ORIGINAL acquisition source, pinned at creation and
  /// deliberately not overwritten when the student later engages with other
  /// events / agents / partners. `sourceId` remains mutable (current
  /// relationship owner), `originalSourceId` is the audit trail.
  originalSourceId   String?
  originalSource     RecruitmentPartner? @relation("OriginalSource", fields: [originalSourceId], references: [id])
  /// Spec §16 — the specific event that originally captured this lead. Pinned
  /// at creation like `originalSourceId`.
  originalEventId    String?
  originalEvent      Event?       @relation("OriginalEvent", fields: [originalEventId], references: [id])
  /// Spec §16 — first business-side touchpoint (as opposed to `createdAt`
  /// which is the DB write time). Populated at capture; usually equal to
  /// createdAt for online submissions, but can be back-dated for offline
  /// batch uploads.
  firstTouchDate     DateTime?
  /// Spec Recruitment Network — how the lead entered the CRM. Selectable
  /// values, not a records table.
  channel            LeadChannel?

  /// Permission to send this person commercial email.
  ///
  /// Three-valued on purpose: NULL means nobody has asked, false means they
  /// were asked and said no. A plain boolean defaulting to false collapses
  /// those two into the same thing, and under CASL the difference is the whole
  /// point — "never asked" is a gap to go and close, "declined" is a record you
  /// must honour and be able to produce.
  marketingConsent   Boolean?
  /// When consent was given or refused. CASL requires being able to show *when*
  /// and in what circumstances, so the flag alone is not a defensible record.
  marketingConsentAt DateTime?

  /// Spec §1 — per-channel communication preferences (migration 037). Only
  /// marketing EMAIL consent existed, while the spec asks for "consent and
  /// communication preferences" as a set.
  ///
  /// All three are three-valued for the same reason as `marketingConsent`:
  /// NULL means nobody asked, false means they were asked and said no.
  phoneContactConsent    Boolean?
  smsContactConsent      Boolean?
  whatsappContactConsent Boolean?
  /// A blanket override across every channel. Plain boolean, unlike the three
  /// above, because its absence genuinely means "no such instruction was
  /// given", which is the same thing as false.
  doNotContact           Boolean   @default(false)
  doNotContactAt         DateTime?

  /// Spec §1 / §4 — marketing campaign attribution (migration 037). A Campaign
  /// model already existed with nothing linking a student to one, so
  /// `Campaign.leadsGenerated` was a hand-typed integer rather than a count.
  campaignId         String?
  campaign           Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// Idempotency key for offline capture, generated on the device the moment a
  /// lead is written down and never reused.
  ///
  /// A booth upload of 100 leads that dies halfway leaves the ICR no way to
  /// tell which ones landed; without this, pressing Upload again re-creates
  /// every lead that already succeeded. The unique index makes the retry safe:
  /// a captureId that is already present is reported back as a duplicate
  /// instead of inserted. Nullable because leads created in the office have no
  /// device-side origin, and Postgres allows many NULLs under a unique index.
  captureId String? @unique

  /// Denormalised pointer to the application currently in play. A lead can
  /// hold several over its lifetime — rejected by one institution, then
  /// offered by another.
  activeApplicationId String?

  activities            LeadActivity[]
  notesLog              LeadNote[]
  documents             LeadDocument[]
  whatsappConversations WhatsAppConversation[]
  applications          LeadApplication[]
  checklistItems        LeadChecklistItem[]
  /// The N institution journeys this student is pursuing. Populated by
  /// migration 012; every existing Lead gets exactly one interest at rollout.
  institutionInterests  InstitutionInterest[]
  /// Field Ops activities that touch this student (offer discussions, follow-ups).
  fieldActivities       Activity[]           @relation("ActivityLead")

  @@index([email])
  @@index([stage])
  @@index([assignedICRId])
  @@index([institutionId])
  /// Supports the inactivity cron and the "days in stage" sort.
  @@index([stage, deletedAt])
  @@index([stageEnteredAt])
  @@map("leads")
}

/// Two things in one table, separated by `kind`:
///   SYSTEM     — immutable audit (stage changes, assignment, cron actions)
///   ENGAGEMENT — schedulable, completable work that satisfies pipeline gates
///
/// Keeping them together means one timeline for the user; the discriminator
/// keeps the gate honest.
model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Nullable so the automation cron can write SYSTEM rows without a phantom
  /// service user appearing in ICR dashboards.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  type        String
  description String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  kind              LeadActivityKind    @default(SYSTEM)
  engagementType    LeadEngagementType?
  /// Stage when scheduled, and when completed. The gate asks about completion,
  /// and an activity booked in one stage is often completed in the next.
  stageAtCreation   LeadStage?
  stageAtCompletion LeadStage?

  /// Which Institution Interest this activity relates to. Nullable means
  /// "student-level" — e.g. initial counselling before any institution has
  /// been chosen. Set when the activity is scoped to one journey.
  institutionInterestId String?
  institutionInterest   InstitutionInterest? @relation(fields: [institutionInterestId], references: [id], onDelete: SetNull)
  scheduledFor      DateTime?
  completedAt       DateTime?
  outcome           String?             @db.Text
  /// Open future engagements are cancelled when a lead is closed, so they stop
  /// appearing in task lists and triggering reminders.
  cancelledAt       DateTime?
  cancelledReason   String?

  @@index([leadId, createdAt])
  @@index([leadId, kind, stageAtCompletion])
  @@index([scheduledFor])
  @@index([completedAt])
  @@map("lead_activities")
}

/// One row per application attempt. Modelling this as columns on Lead would
/// mean creating an alternative application silently overwrites the rejected
/// one — destroying exactly the history the rejection workflow exists to keep.
model LeadApplication {
  id            String      @id @default(uuid())
  leadId        String
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  program       String

  /// The Institution Interest this application attempt belongs to. Nullable
  /// during the split rollout; migration 012 backfills, later phases enforce
  /// NOT NULL and drop the direct `leadId` FK.
  institutionInterestId String?
  institutionInterest   InstitutionInterest? @relation("InterestApplications", fields: [institutionInterestId], references: [id], onDelete: SetNull)

  // Stage 4 — submission. The spec asks for both a user-entered date and a
  // system timestamp; they answer different questions.
  applicationNumber    String?
  submissionMethod     ApplicationSubmissionMethod?
  submissionDate       DateTime?
  submissionRecordedAt DateTime?

  status ApplicationStatus @default(SUBMITTED)

  // Stage 6 — offer
  offerType       OfferType?
  offerReceivedAt DateTime?
  offerExpiryDate DateTime?
  offerConditions String?          @db.Text
  studentDecision StudentDecision?

  // Stage 7 — deposit / acceptance
  depositDeadline              DateTime?
  /// Distinguishes "deliberately not applicable" from "not filled in yet".
  depositDeadlineNotApplicable Boolean           @default(false)
  depositPaid                  Boolean           @default(false)
  depositDate                  DateTime?
  acceptanceStatus             AcceptanceStatus?
  /// Spec §10 — categorical deposit lifecycle. Replaces the two-boolean shape
  /// (depositPaid + depositDeadlineNotApplicable) which couldn't express
  /// PENDING / PARTIALLY_PAID / WAIVED / REFUNDED. Both stay populated so
  /// existing readers keep working during migration.
  depositStatus                DepositStatus?
  /// Spec §10 — partial-payment support.
  depositAmount                Float?
  depositCurrency              String?
  /// Spec §10 — WHEN the acceptance was recorded. `acceptanceStatus` said what
  /// was decided with no record of when (migration 037).
  acceptanceDate               DateTime?

  // Stage 5 — Awaiting Decision (spec §8, migration 037). Until these existed
  // the Awaiting Decision gate had an empty required-field list, and "notify
  // the ICR when the expected decision date passes" had no date to compare to.
  /// When the institution is expected to decide, where known.
  expectedDecisionDate         DateTime?
  /// Last time the institution told us anything about this application.
  lastInstitutionUpdateAt      DateTime?
  /// What the institution is waiting for, where applicable.
  outstandingRequirement       String?           @db.Text

  /// Spec §7 — the alternative to an application reference number. The spec
  /// requires the reference "where available", with submission confirmation or
  /// evidence where none exists; with nowhere to record evidence the gate had
  /// to demand the reference unconditionally, which blocked any application
  /// submitted by email or to an institution that issues no reference.
  submissionEvidence           String?           @db.Text

  /// Spec §15 — Application-Rejected requires "Appeal possible: Yes/No".
  appealPossible               Boolean?
  rejectionDate                DateTime?

  // Rejection — kept per application, not on the lead
  rejectionReason String? @db.Text
  rejectionNotes  String? @db.Text

  /// False once superseded by an alternative application.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, isActive])
  @@index([institutionId])
  @@index([institutionInterestId])
  @@map("lead_applications")
}

/// The recruitment journey for one student × institution pair.
///
/// Split out from `Lead` in migration 012. A single Student Profile (Lead) can
/// pursue several institutions in parallel without the pipeline collapsing
/// them into "the student's stage" — stage, eligibility, offer, deposit and
/// enrolment all belong to the journey, not the person.
///
/// Lead retains the person-level fields (name, email, phone, initial intent,
/// attribution, consent). InstitutionInterest carries everything downstream of
/// "which institution?"
///
/// Rollout is additive: Lead.stage and Lead.institutionId stay populated
/// during Phase 1 so the existing UI and analytics keep working. Later phases
/// cut readers over, then drop those columns.
///
/// Enum reuse: this model reuses `LeadStage`. The rename to
/// `InstitutionInterestStage` is deferred to a later migration once the split
/// is fully cutover — renaming a shared enum while both tables read from it
/// is safe in Postgres but easier to reason about in one pass.
model InstitutionInterest {
  id            String       @id @default(uuid())
  leadId        String
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])

  /// Programme within the institution. Nullable because a student can express
  /// interest before deciding the exact programme — populated by Qualified.
  program     String?
  intakeYear  Int
  intakeMonth Int
  studyLevel  StudyLevel

  /// Per-institution owner. May differ from Lead.assignedICRId — e.g. the UAE
  /// ICR owns the student, but a UK specialist owns the UCL interest.
  assignedICRId String?
  assignedICR   User?   @relation("InterestAssignedICR", fields: [assignedICRId], references: [id])

  // ─── Pipeline mechanics ─────────────────────────────────────────────────
  stage                  LeadStage  @default(NEW_LEAD)
  stageEnteredAt         DateTime   @default(now())
  stageBeforeClose       LeadStage?
  lastContactedAt        DateTime?
  lastProgressedAt       DateTime?
  inactivity14NotifiedAt DateTime?
  inactivity21NotifiedAt DateTime?

  // ─── Stage 3: Qualified ─────────────────────────────────────────────────
  eligibilityOutcome     EligibilityOutcome?
  eligibilityConfirmedAt DateTime?
  academicQualification  String?
  englishStatus          EnglishStatus?

  // ─── Stage 8: Enrolled ──────────────────────────────────────────────────
  enrolmentDate      DateTime?
  /// Spec §11 — categorical enrolment lifecycle. `isConverted:Boolean` below
  /// stays true whenever any non-terminal enrolment state is set, so old
  /// analytics keep working.
  enrolmentStatus    EnrolmentStatus?
  isConverted        Boolean   @default(false)
  commissionEligible Boolean   @default(false)
  convertedAt        DateTime?

  // ─── Closed outcomes (per-interest) ─────────────────────────────────────
  /// Lost / deferred / rejected outcomes apply to one journey at a time. A
  /// student rejected by UofT may still be Offer Received at Manchester.
  lostReason          LeadLostReason?
  lostDate            DateTime?
  lostNotes           String?         @db.Text
  deferredIntakeYear  Int?
  deferredIntakeMonth Int?
  deferredReason      String?         @db.Text
  deferredFollowUpAt  DateTime?
  deferredReopenAt    DateTime?

  /// Denorm pointer to the application attempt currently in play within this
  /// interest. Mirrors the pattern already established on Lead.
  activeApplicationId String?

  /// Set when the interest closes (LOST, APPLICATION_REJECTED, ENROLLED).
  /// A partial unique index in migration 012 enforces "only one open interest
  /// per (student, institution)" — a re-attempt closes the old row and opens
  /// a new one so history is preserved instead of overwritten.
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications   LeadApplication[]   @relation("InterestApplications")
  activities     LeadActivity[]
  checklistItems LeadChecklistItem[]
  /// Spec §20 — per-journey documents (offer letter, application form,
  /// deposit receipt) attach here. Student-level documents (passport, CV,
  /// English test) live on Lead with institutionInterestId = NULL.
  documents      LeadDocument[]

  @@index([leadId])
  @@index([institutionId])
  @@index([stage])
  @@index([assignedICRId])
  /// Supports the inactivity cron and days-in-stage sort at interest level.
  @@index([stage, stageEnteredAt])
  @@map("institution_interests")
}

/// Checklist items generated on entering Qualified (documents) and
/// Deposit Paid (visa, pre-departure, accommodation).
model LeadChecklistItem {
  id         String                @id @default(uuid())
  leadId     String
  lead       Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Which Institution Interest generated this checklist. Programme-specific
  /// document lists (Qualified stage) and visa/pre-departure lists (Deposit
  /// Paid) are per-interest, not per-student. Nullable during rollout.
  institutionInterestId String?
  institutionInterest   InstitutionInterest? @relation(fields: [institutionInterestId], references: [id], onDelete: SetNull)
  category   LeadChecklistCategory
  label      String
  isRequired Boolean               @default(true)
  order      Int                   @default(0)

  completedAt   DateTime?
  completedById String?
  /// Links a satisfied document requirement to the file that satisfied it.
  documentId    String?
  document      LeadDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// UNIQUENESS IS NOT DECLARED HERE — it lives in migration 037 as two
  /// PARTIAL unique indexes, which Prisma cannot express:
  ///   ("leadId", "institutionInterestId", category, label) WHERE interest IS NOT NULL
  ///   ("leadId", category, label)                          WHERE interest IS NULL
  ///
  /// It was `@@unique([leadId, category, label])` — per STUDENT — while this
  /// model's own comments and spec §6 both describe programme-specific lists
  /// belonging to one journey. A second interest reaching Qualified therefore
  /// generated nothing, because createMany's skipDuplicates matched the first
  /// interest's rows. A plain four-column unique would not fix it either:
  /// Postgres treats NULLs as distinct, so student-level rows could duplicate
  /// without limit.
  ///
  /// `createMany({ skipDuplicates: true })` still works — it emits
  /// ON CONFLICT DO NOTHING, which honours any unique index including partial
  /// ones. Do not re-add an @@unique here; it would recreate the old rule.
  @@index([leadId, category])
  @@map("lead_checklist_items")
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_notes")
}

model LeadDocument {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Spec §20 — some documents are per-journey (application form,
  /// programme statement, offer letter, deposit receipt) rather than
  /// student-level (passport, CV, English test). NULL means student-level
  /// and is reusable across all institution interests.
  institutionInterestId String?
  institutionInterest   InstitutionInterest? @relation(fields: [institutionInterestId], references: [id], onDelete: SetNull)
  name       String
  url        String
  type       String
  size       Int?
  uploadedAt DateTime @default(now())
  uploadedBy String

  checklistItems LeadChecklistItem[]

  @@index([leadId])
  @@index([institutionInterestId])
  @@map("lead_documents")
}

// ─── PILLAR 2: SOURCES ─────────────────────────────────────────────────────

/// Spec §1 (Recruitment Network) — rename Source → RecruitmentPartner.
///
/// This is a Prisma-only rename: `@@map("sources")` keeps the underlying
/// Postgres table exactly where it was, so no data migration is needed and
/// every existing FK (`sourceId` columns on Lead, Campaign, Activity, etc.)
/// keeps pointing at the same rows. What changed is the JS API: what was
/// `db.source.*` is now `db.recruitmentPartner.*`.
///
/// FK column names (`sourceId`, `originalSourceId`) stay as-is to avoid
/// the multi-table rename cascade — the JS field name and the DB column
/// name can differ, and the code has been updated to use the property
/// names consistent with the new model.
model RecruitmentPartner {
  id              String     @id @default(uuid())
  name            String
  type            SourceType
  country         String
  city            String?
  contactPerson   String?
  email           String?
  phone           String?
  agreementStatus String?
  rating          Int?
  notes           String?    @db.Text
  isActive        Boolean    @default(true)
  lastActiveAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  createdById     String

  regionId  String?
  region    Region?    @relation(fields: [regionId], references: [id])
  leads     Lead[]
  /// Spec §16 back-ref for the immutable original-source pin on Lead.
  originalLeads Lead[]  @relation("OriginalSource")
  campaigns Campaign[]

  // Phase 1
  agentProfile AgentProfile?
  activities   Activity[]    @relation("ActivitySource")

  // Phase 2 — Recruitment Network
  partnerContacts PartnerContact[]

  @@map("sources")
}

model Campaign {
  id             String    @id @default(uuid())
  name           String
  channel        String
  /// Spec §12 (Recruitment Network) — campaign type / event category.
  type           String?
  startDate      DateTime
  endDate        DateTime?
  /// Spec §12 (Recruitment Network) — Country/City/Venue required for
  /// dedup by (name + city + country + date) and for reporting.
  country        String?
  city           String?
  venue          String?
  budget         Float?
  actualSpend    Float?
  expectedAttendance Int?
  actualAttendance   Int?
  eventOrganizer     String?
  leadsGenerated Int       @default(0)
  notes          String?   @db.Text
  /// DEPRECATED — replaced by `status`. Kept during rollout so existing rows
  /// survive; new code should read `status`.
  isActive       Boolean   @default(true)
  /// Spec §10 (Recruitment Network) — Campaign lifecycle. Nullable during
  /// rollout; migration 019 backfills based on `isActive` + dates.
  status         CampaignStatus?
  /// Spec §11 — closure requires end date + actual budget + participating
  /// institutions confirmed + outcome summary.
  outcomeSummary String?   @db.Text
  ownerId        String?
  owner          User?     @relation("CampaignOwner", fields: [ownerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String

  sourceId String?
  source   RecruitmentPartner? @relation(fields: [sourceId], references: [id])

  /// Field Ops activities linked to this campaign.
  activities Activity[] @relation("ActivityCampaign")
  /// Spec §1 — students attributed to this campaign (migration 037).
  /// `leadsGenerated` above is a hand-entered figure and is NOT derived
  /// from this; the two can disagree.
  leads      Lead[]

  @@index([status])
  @@index([name, city, country, startDate])
  @@map("campaigns")
}

// ─── PILLAR 3: INSTITUTIONS / ERM ─────────────────────────────────────────

model Institution {
  id             String        @id @default(uuid())
  name           String
  /// Spec §3 (Clients) — the legal name may differ from the display name
  /// (e.g. "University of Toronto" vs "Governing Council of the University of
  /// Toronto"). Nullable during rollout; forms populate it from `name` if left
  /// blank.
  legalName      String?
  country        String
  type           String
  website        String?
  logoUrl        String?
  primaryContact String?
  accountStatus  AccountStatus @default(PROSPECT)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  createdById    String

  // Phase 1: Client Management fields
  contractValue       Float?
  renewalDate         DateTime?
  /// DEPRECATED per spec §2 (Clients): "Remove the Budget card unless a clear
  /// and consistently maintained budget process is introduced." Kept in the
  /// schema for one release so existing rows don't fail; UI has stopped
  /// reading them. Migration 019 marks them as no-longer-required.
  budgetTotal         Float?
  budgetUsed          Float?    @default(0)
  strategicObjectives String?   @db.Text
  overview            String?   @db.Text

  /// Spec §11 (Clients) — Account Health traffic-light. Selected by the
  /// Account Manager; AMBER/RED require a matching AccountIntervention record.
  accountHealth       AccountHealth @default(GREY)
  /// Spec §3 (Clients) — how often reports are due for this client.
  reportingFrequency  ReportingFrequency?
  /// Spec §3 (Clients) — which services this client has actually bought.
  /// Multi-select; Postgres text[] under the hood.
  serviceScope        ServiceScope[]

  regionId         String?
  region           Region? @relation(fields: [regionId], references: [id])
  /// Every region this client is worked in. `regionId` above is the primary and
  /// should also appear in here — see InstitutionRegion.
  regions          InstitutionRegion[]
  accountManagerId String?
  accountManager   User?   @relation("AccountManager", fields: [accountManagerId], references: [id])
  /// Spec §3 (Clients) — the Regional Manager owning this client from the
  /// operations side, distinct from the Account Manager on the commercial side.
  regionalManagerId String?
  regionalManager   User?   @relation("InstitutionRegionalManager", fields: [regionalManagerId], references: [id])

  leads             Lead[]
  leadApplications  LeadApplication[]
  institutionInterests InstitutionInterest[]
  contacts          InstitutionContact[]
  contracts         Contract[]
  engagementLogs    EngagementLog[]
  deliverables      Deliverable[]
  documents         InstitutionDocument[]
  // events → EventInstitution back-ref dropped in migration 021 in favour of
  // eventParticipations below (rich join with ICR / status / notes).
  monthlyReports    MonthlyReport[]
  users             InstitutionUser[]
  enrollmentTargets EnrollmentTarget[]

  // Phase 1 relations
  activities      Activity[]
  clientKPIs      ClientKPI[]
  riskRegisters   RiskRegister[]
  complianceItems ComplianceItem[]
  knowledgeBases  KnowledgeBase[]
  qbrs            QuarterlyBusinessReview[]

  // Phase 2 / 4 redesign back-refs
  eventParticipations       EventParticipation[]
  plannedEventParticipations PlannedEventParticipation[]
  recruitmentPlans          QuarterlyRecruitmentPlan[]

  // Phase 5 — Clients spec closure
  issues                    ClientIssue[]
  interventions             AccountIntervention[]

  // Timesheets — time booked against this client (migration 028)
  timesheetEntries          TimesheetEntry[] @relation("TimesheetEntryClient")
  transitionReports         TransitionReport[]
  forecasts                 Forecast[]

  @@map("institutions")
}

/// Spec §4 (Clients) — team assignment record. The old shape was just
/// (institutionId, userId); the spec asks for account role, region/market,
/// start date and status.
model InstitutionUser {
  institutionId String
  userId        String
  institution   Institution @relation(fields: [institutionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  accountRole         AccountRole?
  region              String?
  assignmentStartDate DateTime?
  assignmentStatus    AssignmentStatus @default(ACTIVE)
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@id([institutionId, userId])
  @@index([userId])
  @@index([assignmentStatus])
  @@map("institution_users")
}

model InstitutionContact {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  title         String?
  email         String?
  phone         String?
  isPrimary     Boolean     @default(false)
  /// Spec §5 (Clients) — categorisation for reporting and filtering.
  category      ContactCategory?
  /// Spec §5 (Clients) — free-text department (e.g. "International Office").
  department    String?
  /// Spec §5 (Clients) — which Illume user owns the relationship with this contact.
  relationshipOwnerId String?
  relationshipOwner   User?   @relation("ContactOwner", fields: [relationshipOwnerId], references: [id])
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId, isActive])
  @@map("institution_contacts")
}

model Contract {
  id            String               @id @default(uuid())
  institutionId String
  institution   Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  value         Float?
  startDate     DateTime
  endDate       DateTime
  documentUrl   String?
  /// Spec §6 (Clients): status is now a controlled enum. Kept as String during
  /// rollout because existing rows use the free-text "ACTIVE"/"PENDING" etc;
  /// migration 019 backfills the enum column and later phases drop this one.
  status        String               @default("ACTIVE")
  statusEnum    ContractStatus?
  /// Spec §6 (Clients) — contract type (Master Services, Recruitment, MOU, etc).
  type          ContractType?
  /// Spec §6 (Clients) — notice period in days (e.g. 90).
  noticePeriodDays Int?
  /// Spec §6 (Clients) — commercial owner. Distinct from `createdById`
  /// which records who typed the row in.
  ownerId       String?
  owner         User?                @relation("ContractOwner", fields: [ownerId], references: [id])
  /// Spec §6 (Clients) — currency (ISO 4217).
  currency      String?
  /// Spec §6 (Clients) — free-text payment structure (e.g. "50% upfront,
  /// 50% on enrolment"). Structured payment schedule can be a Phase 2 addition.
  paymentStructure String?          @db.Text
  /// Spec §6 (Clients) — when a contract is replaced, the new row points at
  /// the old one. Old row's statusEnum → SUPERSEDED (never deleted).
  supersededById   String?
  supersededBy     Contract?         @relation("ContractSupersession", fields: [supersededById], references: [id])
  supersedes       Contract[]        @relation("ContractSupersession")
  notes         String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  createdById   String
  attachments   ContractAttachment[]
  documents     InstitutionDocument[] @relation("DocumentContract")

  @@index([institutionId, statusEnum])
  @@index([endDate])
  @@map("contracts")
}

model ContractAttachment {
  id         String   @id @default(uuid())
  contractId String
  name       String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_attachments")
}

model EngagementLog {
  id            String          @id @default(uuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  type          InteractionType
  date          DateTime
  notes         String?         @db.Text
  outcome       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("engagement_logs")
}

model Deliverable {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  description   String?     @db.Text
  dueDate       DateTime?
  completedAt   DateTime?
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("deliverables")
}

model InstitutionDocument {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  url           String
  /// Legacy free-text type; kept during rollout so existing rows survive.
  /// Prefer `category` for new writes.
  type          String
  /// Spec §10 (Clients) — controlled category.
  category      DocumentCategory?
  /// Spec §10 (Clients) — optional expiry (e.g. accreditation certificate).
  expiresAt     DateTime?
  /// Spec §10 (Clients) — optional document version (e.g. "v2", "2026-Q3").
  version       String?
  /// Spec §10 (Clients) — link the doc to the record it relates to.
  contractId    String?
  contract      Contract?   @relation("DocumentContract", fields: [contractId], references: [id], onDelete: SetNull)
  issueId       String?
  issue         ClientIssue? @relation("DocumentIssue", fields: [issueId], references: [id], onDelete: SetNull)
  activityId    String?
  activity      Activity?   @relation("DocumentActivity", fields: [activityId], references: [id], onDelete: SetNull)
  size          Int?
  uploadedAt    DateTime    @default(now())
  uploadedBy    String

  @@index([institutionId, category])
  @@map("institution_documents")
}

/// Spec §9 (Clients) — Issues & Actions module. Tracks anything that needs
/// follow-up or escalation on a client account.
model ClientIssue {
  id             String        @id @default(uuid())
  institutionId  String
  institution    Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title          String
  description    String?       @db.Text
  category       IssueCategory
  severity       IssueSeverity @default(MEDIUM)
  status         IssueStatus   @default(OPEN)
  ownerId        String
  owner          User          @relation("IssueOwner", fields: [ownerId], references: [id])
  openedAt       DateTime      @default(now())
  targetResolutionAt DateTime?
  resolvedAt     DateTime?
  resolutionNotes String?      @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String

  /// Documents attached to the issue (screenshots, emails, RCA docs).
  documents      InstitutionDocument[] @relation("DocumentIssue")

  @@index([institutionId, status])
  @@index([ownerId, status])
  @@index([severity, status])
  @@index([targetResolutionAt])
  @@map("client_issues")
}

/// Spec §11 (Clients) — when Account Health is set AMBER or RED, a matching
/// intervention record is required. This drives the "attention required" panel
/// and the RM check-in cycle.
model AccountIntervention {
  id                String        @id @default(uuid())
  institutionId     String
  institution       Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  health            AccountHealth
  reason            String        @db.Text
  correctiveAction  String        @db.Text
  actionOwnerId     String
  actionOwner       User          @relation("InterventionOwner", fields: [actionOwnerId], references: [id])
  reviewDate        DateTime
  resolvedAt        DateTime?
  resolutionNotes   String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String

  @@index([institutionId, resolvedAt])
  @@index([reviewDate])
  @@map("account_interventions")
}

model EnrollmentTarget {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  year          Int
  target        Int
  actual        Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("enrollment_targets")
}

// ─── PILLAR 5: EVENTS ─────────────────────────────────────────────────────

model Event {
  id             String      @id @default(uuid())
  name           String
  type           EventType
  date           DateTime
  city           String
  country        String
  status         EventStatus @default(PLANNED)
  budget         Float?
  totalCost      Float       @default(0)
  notes          String?     @db.Text
  postEventNotes String?     @db.Text
  /// Spec §9 (Recruitment Events) — measurable objectives defined before the
  /// event begins. Stored as JSON so we don't need a child table for a small
  /// number of items per event. Shape:
  ///   [{ target: "Generate 100 student enquiries", metric?: "enquiries",
  ///      goal?: 100, achieved?: 87, notes?: "..." }, ...]
  objectives     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  createdById    String

  regionId      String?
  region        Region? @relation(fields: [regionId], references: [id])
  assignedICRId String?
  assignedICR   User?   @relation(fields: [assignedICRId], references: [id])

  // EventInstitution join was dropped in migration 021. The rich
  // EventParticipation model (participations back-ref below) is now the
  // sole join for institutions on events.
  leads        Lead[]
  /// Spec §16 back-ref for the immutable original-event pin on Lead.
  originalLeads Lead[] @relation("OriginalEvent")
  expenses     EventExpense[]
  /// Field Ops activities linked to this event (event prep, follow-up work).
  activities   Activity[]   @relation("ActivityEvent")

  // Phase 2 / 4 redesign back-refs
  participations             EventParticipation[]
  plannedTravelLinks         PlannedTravel[]
  plannedEventParticipations PlannedEventParticipation[]

  @@map("events")
}

// EventInstitution model dropped in migration 021 — see the retirement note
// on Event.participations above. Left as a marker comment so a reader sees
// what was here previously.

model EventExpense {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  category    String?
  receiptUrl  String?
  createdAt   DateTime @default(now())

  @@map("event_expenses")
}

// ─── PILLAR 6: REPORTS & FORECASTING ─────────────────────────────────────

model MonthlyReport {
  id             String       @id @default(uuid())
  icrId          String
  icr            User         @relation("ICRReports", fields: [icrId], references: [id])
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id])
  regionId       String?
  region         Region?      @relation(fields: [regionId], references: [id])
  reportingMonth Int
  reportingYear  Int
  status         ReportStatus @default(DRAFT)

  leadsData               Json?
  programBreakdown        Json?
  sourcePerformance       Json?
  eventActivities         Json?
  kpiSummary              Json?
  engagementNotes         String? @db.Text
  challengesOpportunities String? @db.Text
  nextMonthPlan           String? @db.Text
  successStories          String? @db.Text
  marketInsights          String? @db.Text

  submittedAt     DateTime?
  finalApprovedAt DateTime?
  pdfUrl          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  approvals       ReportApproval[]

  @@unique([icrId, institutionId, reportingMonth, reportingYear])
  @@map("monthly_reports")
}

model ReportApproval {
  id        String         @id @default(uuid())
  reportId  String
  report    MonthlyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  action    ApprovalAction
  comment   String?        @db.Text
  createdAt DateTime       @default(now())

  @@map("report_approvals")
}

/// The ICR Monthly Report — the CRM equivalent of the "Illume - ICR - Monthly
/// Report Template (Master)" Word template the reps fill in by hand today.
///
/// Deliberately keyed on the REP, not the institution. `MonthlyReport` above is
/// one row per ICR *per institution*, which means a rep covering four schools
/// files four reports and nobody ever sees their month as a whole. This is one
/// row per rep per month; the institution appears as a breakdown inside the
/// report (`institutionBreakdown`) instead of as part of the identity. Both
/// models stay live — this one does not replace the institution report, and
/// neither reads the other's rows.
///
/// The Json columns are FROZEN SNAPSHOTS of what the CRM knew when the report
/// was generated, not live views. A report that silently re-computed itself
/// would mean the figures a manager approved in September are not the figures
/// anyone reads in November. `refreshedAt` records the last deliberate recompute,
/// which is only permitted while the report is still DRAFT or RETURNED — once
/// it is with a manager the numbers stop moving.
///
/// Free-text columns are the sections of the template the CRM cannot know:
/// judgement, narrative and asks. They map 1:1 onto the template's numbering,
/// which is why the column comments carry the section numbers.
model IcrMonthlyReport {
  id             String       @id @default(uuid())
  icrId          String
  icr            User         @relation("ICRMonthlyReports", fields: [icrId], references: [id])
  regionId       String?
  region         Region?      @relation(fields: [regionId], references: [id])
  reportingMonth Int
  reportingYear  Int
  status         ReportStatus @default(DRAFT)

  /// Template header — free text because an intake label ("Sep 2026 / Jan 2027")
  /// is a recruitment cycle, and the CRM has no single field that names one.
  intakesCovered String?

  // ── Auto-filled from the CRM (snapshots) ────────────────────────────────
  /// §1.1 — one row per metric: { key, label, target, thisMonth, previousMonth, trend }.
  performance          Json?
  /// §1.2 — { activeLeads, applicationsInProgress, offersPending, depositsPending }.
  pipelineSnapshot     Json?
  /// Rollup per institution the rep worked this month. Not in the paper
  /// template — it is what the paper template loses by being institution-scoped.
  institutionBreakdown Json?
  /// §1.3 — applications the CRM believes are stuck, each with an editable
  /// `issue` and `requiredAction` the rep can overwrite.
  priorityApplications Json?
  /// §2.1 — { agentMeetings, newAgentsIdentified, trainingsDelivered, accountPlanning }.
  agentEngagement      Json?
  /// §2.2 — per partner: { id, name, leads, applications, deposits, note }.
  topAgents            Json?
  /// §2.3 — partners the CRM flags as at risk, with an editable action plan.
  atRiskAgents         Json?
  /// §3.1 — per event: { id, name, date, cost, leadsGenerated, costPerLead, quality }.
  eventActivities      Json?
  /// §8 — Monthly KPI. The six mandatory activities from the "Illume KPIs —
  /// Weekly Activity Planner", rolled up from the four weeks of this month:
  /// per type { type, label, cadence, target, completed, pct, entered, detail[] }.
  ///
  /// `entered` distinguishes "the planner says zero" from "the planner was never
  /// filled in". A rep who did the work but skipped the spreadsheet must not be
  /// reported at 0%, which reads as failure rather than as missing data.
  monthlyKpi           Json?

  // ── Written by the rep ──────────────────────────────────────────────────
  /// §1.4
  keyHighlights        String? @db.Text
  /// §1.5
  keyChallenges        String? @db.Text
  /// §2.4
  channelDevelopment   String? @db.Text
  /// §3.2
  businessDevelopment  String? @db.Text
  /// §4.1
  demandTrends         String? @db.Text
  /// §4.2
  competitiveActivity  String? @db.Text
  /// §4.3
  marketConditions     String? @db.Text
  /// §5 — three separate columns rather than one blob, because the template
  /// asks for exactly three and a manager should be able to read them apart.
  priorityOne          String? @db.Text
  priorityTwo          String? @db.Text
  priorityThree        String? @db.Text
  /// §6
  supportRequested     String? @db.Text

  generatedAt     DateTime  @default(now())
  refreshedAt     DateTime?
  submittedAt     DateTime?
  finalApprovedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  approvals IcrReportApproval[]

  @@unique([icrId, reportingMonth, reportingYear])
  @@index([status])
  @@index([regionId, status])
  @@map("icr_monthly_reports")
}

/// Append-only trail for the ICR report. Separate from `ReportApproval` because
/// that table's FK points at `monthly_reports`; sharing it would mean a nullable
/// parent on every row and no way for the database to enforce that a decision
/// belongs to exactly one report.
model IcrReportApproval {
  id        String           @id @default(uuid())
  reportId  String
  report    IcrMonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  action    ApprovalAction
  comment   String?          @db.Text
  createdAt DateTime         @default(now())

  @@index([reportId, createdAt])
  @@map("icr_report_approvals")
}

// ForecastEntry model removed 2026-08-09 (Phase 7). Orphaned since the
// 2026-05-30 report simplification. Migration 018 drops the underlying
// forecast_entries table after snapshotting its rows into audit_logs.

// Weekly Activity Planner — one row per ICR per week per mandatory activity.
// Tracked & viewed (no approval workflow); rolls up into the monthly report.
model WeeklyActivity {
  id          String             @id @default(uuid())
  icrId       String
  icr         User               @relation("ICRWeeklyActivities", fields: [icrId], references: [id])
  regionId    String?
  region      Region?            @relation(fields: [regionId], references: [id])
  year        Int
  month       Int // 1-12
  weekOfMonth Int // 1-4
  type        WeeklyActivityType
  target      Int // expected count for the week
  completed   Int                @default(0)
  detail      String?            @db.Text // free-text: agency / school names, notes
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([icrId, year, month, weekOfMonth, type])
  @@index([icrId, year, month])
  @@index([regionId, year, month])
  @@map("weekly_activities")
}

// ─── ERP MODULE ────────────────────────────────────────────────────────────

model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  parentId    String?
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employees       Employee[]
  accountRequests AccountRequest[]
  timesheetEntries TimesheetEntry[] @relation("TimesheetEntryDepartment")

  @@map("departments")
}

model Employee {
  id               String         @id @default(uuid())
  employeeId       String         @unique
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  photoUrl         String?
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id])
  jobTitle         String
  employmentType   EmploymentType @default(FULL_TIME)
  managerId        String?
  manager          Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports    Employee[]     @relation("EmployeeManager")
  startDate        DateTime
  endDate          DateTime?
  /// Determines eligibility for maternity and paternity leave. Nullable
  /// because it is unknown for employees created before this field existed;
  /// a null blocks the parental types until HR fills it in.
  gender           Gender?
  phone            String?
  emergencyContact String?
  emergencyPhone   String?
  address          String?        @db.Text
  contractUrl      String?
  jobDescription   String?        @db.Text
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // ─── Timesheet configuration (spec §Timesheets, migration 028) ──────────
  /// Whether this employee has to submit timesheets at all. Defaults to false
  /// deliberately: the spec asks for time recording from designated staff
  /// (initially Finance) and states plainly that ICRs must NOT be required to
  /// submit unless this is switched on for them individually. Defaulting to
  /// true would generate periods, reminders and overdue chases company-wide.
  timesheetRequired    Boolean             @default(false)
  timesheetFrequency   TimesheetFrequency?
  /// Contracted hours for one WEEK. Periods scale this by their own length, so
  /// a monthly period needs no second number kept in step with this one.
  standardWorkingHours Float?
  /// Who reviews this person's timesheets. Its own field rather than reusing
  /// `managerId`, because the spec lists it separately — finance time is often
  /// approved by a finance lead rather than the line manager. Falls back to the
  /// manager when unset; see resolveApprover in lib/timesheets.ts.
  timesheetApproverId  String?
  timesheetApprover    Employee?           @relation("EmployeeTimesheetApprover", fields: [timesheetApproverId], references: [id])
  timesheetApprovees   Employee[]          @relation("EmployeeTimesheetApprover")
  /// Cost centre for finance reporting. Kept alongside `departmentId` rather
  /// than derived from it: the spec reports on department AND cost centre, and
  /// the two are not always the same split.
  costCentre           String?

  leaveBalances      LeaveBalance[]
  successionPlans    SuccessionPlan[]    @relation("SuccessionEmployee")
  leaveRequests      LeaveRequest[]
  /// DEPRECATED by migration 028 — superseded by TimesheetEntry.
  /// Worklog had no create/update path anywhere in the app and zero rows: it
  /// was a read-only tab with no way to put data in it. Timesheets own employee
  /// time recording now. Kept only so the existing employee tab still compiles;
  /// do not add writers.
  worklogs           Worklog[]
  timesheets         Timesheet[]         @relation("TimesheetEmployee")
  timesheetApprovals Timesheet[]         @relation("TimesheetApprover")
  travelRequests     TravelRequest[]
  performanceReviews PerformanceReview[]
  kpiTargets         KPITarget[]
  trainingRecords    TrainingRecord[]
  assetAssignments   AssetAssignment[]
  attendances        Attendance[]
  tasks              Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  documents          EmployeeDocument[]
  onboardingItems    OnboardingItem[]
  offboardingRequests OffboardingRequest[]

  @@map("employees")
}

// ─── TIMESHEETS (spec §Timesheets, migration 028) ──────────────────────────
//
// Structured time recording for designated staff, initially Finance. Owned by
// the HR & ERP module.
//
// The spec's Core Rule is load-bearing: Timesheets and Field Operations are
// SEPARATE. Field Operations (model Activity) records operational delivery and
// outcomes — what was achieved on a visit. Timesheets record working time for
// employees whose roles require time reporting. Do not merge them, and do not
// derive one from the other; an ICR's field activity is not a timesheet entry.

enum TimesheetFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Spec workflow: Draft → Submitted → Manager Review → Approved, with a
/// Manager Review → Amendments Required → resubmission loop.
enum TimesheetStatus {
  DRAFT
  SUBMITTED
  MANAGER_REVIEW
  AMENDMENTS_REQUIRED
  APPROVED
}

/// What the time was spent on. An enum rather than free text so the spec's
/// "report by Work Category" is answerable — a free-text category cannot be
/// grouped, which is the same reason LeadLostReason is an enum.
enum WorkCategory {
  CLIENT_WORK
  INTERNAL_PROJECT
  ADMINISTRATION
  FINANCE_OPERATIONS
  MEETINGS
  TRAINING
  RECRUITMENT_SUPPORT
  OTHER
}

model Timesheet {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("TimesheetEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  /// Copied from the employee at generation time, not read live. A change to
  /// someone's frequency must not silently restate the periods already issued
  /// to them under the old one.
  frequency   TimesheetFrequency
  periodStart DateTime           @db.Date
  periodEnd   DateTime           @db.Date

  /// All four are SYSTEM-CALCULATED and must never be user-entered — the
  /// CRM-wide rule against manually keyed totals. expectedHours is derived from
  /// the employee's standard week scaled to the period; loggedHours is the sum
  /// of entries; approvedLeaveHours comes from approved LeaveRequests
  /// overlapping the period; variance = totalAccounted - expected.
  expectedHours       Float @default(0)
  loggedHours         Float @default(0)
  approvedLeaveHours  Float @default(0)
  totalAccountedHours Float @default(0)
  variance            Float @default(0)

  status      TimesheetStatus @default(DRAFT)
  submittedAt DateTime?
  approvedAt  DateTime?
  approverId  String?
  approver    Employee?       @relation("TimesheetApprover", fields: [approverId], references: [id])
  /// Mandatory when returning a timesheet for amendment — an employee told to
  /// change something must be told what.
  reviewNotes String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TimesheetEntry[]
  events  TimesheetEvent[]

  /// One timesheet per employee per period. Also the idempotency key for the
  /// period generator, so a cron that runs twice cannot issue duplicates.
  @@unique([employeeId, periodStart])
  @@index([status, periodEnd])
  @@index([employeeId, periodStart])
  @@map("timesheets")
}

model TimesheetEntry {
  id          String    @id @default(uuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  date         DateTime     @db.Date
  workCategory WorkCategory
  description  String       @db.Text
  hours        Float
  notes        String?      @db.Text

  /// Optional client the time was spent on. A real relation, not a typed name:
  /// the spec requires every entity reference to use a CRM lookup rather than a
  /// manually entered identifier.
  institutionId String?
  institution   Institution? @relation("TimesheetEntryClient", fields: [institutionId], references: [id])
  /// Cost centre / department the time is booked against.
  departmentId  String?
  department    Department?  @relation("TimesheetEntryDepartment", fields: [departmentId], references: [id])

  /// Optional link to any other CRM record the work relates to. Reuses
  /// TaskParentType so the polymorphic vocabulary stays single-sourced instead
  /// of a second near-identical enum drifting away from it.
  parentType TaskParentType?
  parentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timesheetId])
  @@index([date])
  @@index([workCategory])
  @@index([institutionId])
  @@map("timesheet_entries")
}

/// Spec: "Maintain complete version and approval history."
///
/// Append-only. Every status transition and every edit to a submitted sheet
/// lands here, so a disputed timesheet can be reconstructed. Distinct from
/// AuditLog: this is user-visible history shown on the timesheet itself, and it
/// keeps the figures as they stood at each transition.
model TimesheetEvent {
  id          String    @id @default(uuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  action     String
  fromStatus TimesheetStatus?
  toStatus   TimesheetStatus?
  /// The acting user, nullable so history outlives a deleted account — the same
  /// reasoning as AuditLog.userId.
  actorId    String?
  notes      String?          @db.Text
  /// Hour figures as they stood at this transition.
  snapshot   Json?

  createdAt DateTime @default(now())

  @@index([timesheetId, createdAt])
  @@map("timesheet_events")
}

/// Records only what has been *consumed*. Entitlement itself is derived from the
/// employee's joining date and the policy in lib/leave-policy.ts, so there is no
/// allocation row to expire at year end and mid-year joiners pro-rate naturally.
/// totalDays is retained for historical rows; adjustmentDays is the supported
/// way for HR to grant or dock days on top of the computed entitlement.
model LeaveBalance {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType
  year           Int
  totalDays      Float     @default(0)
  adjustmentDays Float     @default(0)
  usedDays       Float     @default(0)
  pendingDays    Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([employeeId, leaveType, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String      @id @default(uuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     LeaveType
  startDate     DateTime
  endDate       DateTime
  days          Float
  reason        String?     @db.Text
  status        LeaveStatus @default(PENDING)
  approvedById  String?
  approvedAt    DateTime?
  rejectionNote String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("leave_requests")
}

model Attendance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  overtime    Float?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, date])
  @@map("attendances")
}

model Worklog {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  taskDesc   String   @db.Text
  hours      Float
  notes      String?  @db.Text
  location   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("worklogs")
}

model TravelRequest {
  id            String       @id @default(uuid())
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  destination   String
  purpose       String       @db.Text
  departDate    DateTime
  returnDate    DateTime
  estimatedCost Float?
  actualCost    Float?
  status        TravelStatus @default(PENDING)
  approvedById  String?
  approvedAt    DateTime?
  notes         String?      @db.Text
  receiptUrl    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Phase 1
  itineraryItems TravelItinerary[]
  travelMeetings TravelMeeting[]

  @@map("travel_requests")
}

model PerformanceReview {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String
  period       String
  score        Float?
  strengths    String?   @db.Text
  improvements String?   @db.Text
  goals        String?   @db.Text
  status       String    @default("PENDING")
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("performance_reviews")
}

model KPITarget {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  target      String
  current     String?
  unit        String?
  period      String
  dueDate     DateTime?
  achieved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("kpi_targets")
}

model TrainingRecord {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title          String
  provider       String?
  completedAt    DateTime?
  expiryDate     DateTime?
  certificateUrl String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("training_records")
}

model Task {
  id               String       @id @default(uuid())
  title            String
  description      String?      @db.Text
  assigneeId       String?
  assignee         Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById      String
  createdBy        Employee     @relation("TaskCreator", fields: [createdById], references: [id])
  sourceActivityId String?
  sourceActivity   Activity?    @relation(fields: [sourceActivityId], references: [id])
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(TODO)
  dueDate          DateTime?
  reminderDate     DateTime?
  escalationDate   DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  // ─── Spec §1, §5: Tasks as workflow engine (added Phase 6) ──────────────
  /// Polymorphic parent. Nullable ONLY when `category = PERSONAL`; the API
  /// layer enforces "parent required unless personal" so the DB can stay
  /// loose enough not to require a discriminated join.
  parentType       TaskParentType?
  parentId         String?
  category         TaskCategory     @default(OTHER)
  recurrence       TaskRecurrence   @default(ONE_OFF)
  /// Where a recurring task was generated from a template, keep the pointer
  /// so completing one occurrence doesn't retire the schedule.
  templateId       String?
  template         TaskTemplate?    @relation(fields: [templateId], references: [id])
  estimatedMinutes Int?
  actualMinutes    Int?
  /// Spec Tasks §7 — stamp when the task moves from NOT_STARTED to
  /// IN_PROGRESS. Complements `completedAt` for cycle-time reporting.
  startedAt        DateTime?
  /// Spec Tasks §7 — who closed the task. Denorm off the Employee model so
  /// the audit trail survives assignee changes.
  closedById       String?
  /// Spec Tasks §8 — the reminder cron sets this when a reminder or a
  /// due-soon notification was sent, so we don't nag twice.
  reminderSentAt   DateTime?
  /// Spec Tasks §8 — the reminder cron sets this when an overdue task was
  /// escalated to the RM.
  escalatedAt      DateTime?

  @@index([sourceActivityId])
  @@index([parentType, parentId])
  @@index([category])
  @@index([assigneeId, status])
  @@index([templateId])
  @@index([reminderDate])
  @@index([escalationDate])
  @@map("tasks")
}

model EmployeeDocument {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  type       String
  url        String
  size       Int?
  expiryDate DateTime?
  uploadedAt DateTime  @default(now())
  uploadedBy String

  @@map("employee_documents")
}

model OnboardingItem {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  isOffboarding Boolean   @default(false)
  completedAt   DateTime?
  completedBy   String?
  dueDate       DateTime?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())

  @@map("onboarding_items")
}

/// A manager asking IT to create an account for a new joiner.
///
/// Deliberately does NOT auto-create a User on approval: the business decided
/// IT creates the account by hand. So this is a record plus a notification,
/// carrying enough detail that IT never has to chase the requester for basics.
model AccountRequest {
  id     String               @id @default(uuid())
  status AccountRequestStatus @default(PENDING)

  // Who is being onboarded. Not a relation — the person has no account yet,
  // which is the entire point of the request.
  //
  // Split rather than one free-text name: IT creates the login from this, and a
  // single field left the surname ambiguous for names like
  // "Nur Aisyah Binti Zulkifli". middleName is nullable because many people have
  // none. Note this model keeps its OWN name fields — lib/person-name.ts's
  // PersonName is firstName/lastName only, and widening that shared vocabulary
  // to carry a middle name would touch every Lead and User reader.
  firstName      String
  middleName     String?
  lastName       String
  /// The joiner's PERSONAL address, deliberately not their work one: the work
  /// mailbox does not exist yet — creating it is the point of the request — so
  /// this is where IT sends the new credentials. Named personalEmail rather than
  /// email so it cannot later be mistaken for the work address.
  personalEmail  String
  jobTitle       String
  requestedRole  Role
  employmentType EmploymentType @default(FULL_TIME)
  startDate      DateTime
  gender         Gender?
  phone          String?
  /// Why the account is needed. Required, so a reviewer is never left guessing
  /// at the business case.
  justification  String         @db.Text

  regionId     String?
  region       Region?     @relation(fields: [regionId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  requestedById String
  requestedBy   User   @relation("AccountRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?     @relation("AccountRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  /// Mandatory on rejection, so the requester learns something actionable.
  reviewNotes  String?   @db.Text

  /// Set once IT has actually created the account. Without it an approved
  /// request looks finished while the joiner still has no login.
  fulfilledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([requestedById])
  @@map("account_requests")
}

enum AccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A departure, raised by a manager and reviewed by IT.
///
/// The mirror image of AccountRequest, and deliberately shaped the same way:
/// approving does NOT revoke anything. The business chose to keep revocation a
/// manual act, so `completedAt` records that IT has actually disabled the login —
/// without it an approved departure looks finished while the leaver can still
/// sign in.
model OffboardingRequest {
  id     String                   @id @default(uuid())
  status OffboardingRequestStatus @default(PENDING)

  /// Who is leaving. A real relation, unlike AccountRequest's loose name fields —
  /// there the person has no record yet, whereas here they do, so pointing at it
  /// means the queue cannot drift from the staff record and a picked employee is
  /// guaranteed to exist. Cascade is a formality: employees are soft-deleted via
  /// the user row, never removed.
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reason OffboardingReason

  /// Their last day actually working, which is not necessarily when access should
  /// stop — garden leave ends access earlier, a handover can need it slightly
  /// longer. IT decides that; this is the business fact to decide it from.
  lastWorkingDay DateTime

  /// A personal address for final payslips, references and tax documents. The
  /// same reasoning as AccountRequest.personalEmail, inverted: their work mailbox
  /// is about to stop existing, so anything sent there after the fact is lost.
  forwardingEmail String?

  /// Why they are leaving, in prose. Required — a reviewer disabling someone's
  /// access should never have to guess at the circumstances, and the difference
  /// between a resignation and a termination changes what IT does.
  notes String @db.Text

  requestedById String
  requestedBy   User   @relation("OffboardingRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?     @relation("OffboardingRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  /// Mandatory on rejection, so the requester learns something actionable.
  reviewNotes  String?   @db.Text

  /// Set once IT has actually revoked access. See the model comment.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([requestedById])
  /// Backs the "already a pending departure for this person" guard.
  @@index([employeeId])
  @@map("offboarding_requests")
}

enum OffboardingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Why someone is leaving. Drives nothing automatically — it exists so IT can
/// tell a resignation from a dismissal, which changes the urgency of cutting
/// access, and so HR can report on attrition later.
enum OffboardingReason {
  RESIGNATION
  END_OF_CONTRACT
  TERMINATION
  RETIREMENT
  REDUNDANCY
  OTHER
}

// ─── CROSS-CUTTING MODELS ─────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  // Nullable so an audit trail outlives the account that created it. With a
  // required author, deleting a departing employee either fails on the foreign
  // key or takes their entire history with it — and losing the record of who
  // did what is precisely what an audit log exists to prevent.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  authorId    String
  isGlobal    Boolean   @default(true)
  regionId    String?
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  readReceipts AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  announcementId String
  userId         String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

model KnowledgeBase {
  id            String        @id @default(uuid())
  title         String
  content       String        @db.Text
  category      String
  knowledgeType KnowledgeType @default(GENERAL)
  tags          String[]
  authorId      String
  isPublished   Boolean       @default(true)
  views         Int           @default(0)
  institutionId String?
  institution   Institution?  @relation(fields: [institutionId], references: [id])
  marketId      String?
  market        Market?       @relation(fields: [marketId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  attachments KnowledgeBaseAttachment[]

  @@index([knowledgeType])
  @@index([institutionId])
  @@index([marketId])
  @@map("knowledge_base")
}

model KnowledgeBaseAttachment {
  id        String   @id @default(uuid())
  articleId String
  name      String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  article KnowledgeBase @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("kb_attachments")
}

model ITAsset {
  id           String    @id @default(uuid())
  name         String
  type         String
  serialNumber String?   @unique
  brand        String?
  model        String?
  purchasedAt  DateTime?
  /// How much of `purchasedAt` is actually known — DAY / MONTH / YEAR.
  /// The IT register records a purchase year and month, not a date, and for
  /// roughly a fifth of the fleet not even the year. Without this the screen
  /// renders 2024-06-01 as "1 June 2024" and states a day nobody knows. Set to
  /// DAY for anything entered through the form's date picker.
  purchasePrecision String?
  warrantyEnd  DateTime?
  /// The register's OPERATIONAL state — see `ASSET_STATUSES` in lib/assets.ts.
  /// Deliberately NOT custody: whether a device is out with someone is recorded
  /// by AssetAssignment, which knows who and since when. This column used to
  /// hold AVAILABLE/ASSIGNED, a denormalised copy of "does an assignment row
  /// exist", which left nowhere to say a phone had been stolen. Migration 035
  /// remapped it.
  status       String    @default("SPARE")
  /// Condition, separate from status on purpose: a spare in excellent condition
  /// and a spare that will not power on are the same status and very different
  /// problems.
  condition    String?
  /// The register's "Asset ID" (e.g. UAE-001). Unique where set; almost nothing
  /// is tagged yet.
  assetTag     String?   @unique
  /// Where the device is. A real relation so assets can be scoped and filtered
  /// the way every other regional thing in the app is.
  regionId     String?
  region       Region?   @relation(fields: [regionId], references: [id])
  country      String?
  /// Who is holding the device, BY NAME, and in what job.
  ///
  /// The register names 52 people; the CRM has 16 employees. Requiring an
  /// Employee row to record a custodian would mean either inventing 40 staff
  /// records or discarding the answer to the most-asked question about a laptop.
  /// As accounts are created `AssetAssignment` takes over — it is the stronger
  /// record, being a foreign key with a date range — and this remains the
  /// fallback for devices held by people who are not in the system.
  custodianName     String?
  custodianPosition String?
  /// What came in the box — "Charger, Backpack". Free text because the register
  /// is, and a controlled list fails immediately on real entries like
  /// "Charger - Bad" and "case (to be purchased)", both of which carry
  /// information a checkbox would throw away.
  accessories  String?
  /// Who last physically checked the device, and when. The audit half of an
  /// inventory: a register nobody has verified is a list of what used to be true.
  verifiedBy   String?
  verifiedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignments AssetAssignment[]

  @@index([regionId])
  @@index([status])
  @@index([custodianName])
  @@map("it_assets")
}

model AssetAssignment {
  id         String    @id @default(uuid())
  assetId    String
  asset      ITAsset   @relation(fields: [assetId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?

  @@map("asset_assignments")
}

model PermissionOverride {
  id          String   @id @default(uuid())
  role        Role
