  deposits            Int       @default(0)
  enrolments          Int       @default(0)
  visaApprovals       Int       @default(0)
  yieldRate           Float?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("agent_profiles")
}

// ─── PHASE 1: ACTIVITY MANAGEMENT ─────────────────────────────────────────

model Activity {
  id                    String       @id @default(uuid())
  type                  ActivityType
  title                 String
  description           String?      @db.Text
  date                  DateTime
  endDate               DateTime?
  location              String?
  city                  String?
  country               String?
  studentsEngaged       Int?
  counsellorsEngaged    Int?
  leadsGenerated        Int?
  applicationsGenerated Int?
  cost                  Float?
  roi                   Float?
  outcomes              String?      @db.Text
  followUp              String?      @db.Text
  actionItems           Json?
  topics                String?      @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  userId        String
  user          User         @relation(fields: [userId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  marketId      String?
  market        Market?      @relation(fields: [marketId], references: [id])
  schoolId      String?
  school        School?      @relation("ActivitySchool", fields: [schoolId], references: [id])
  sourceId      String?
  source        Source?      @relation("ActivitySource", fields: [sourceId], references: [id])

  attendees ActivityAttendee[]
  tasks     Task[]

  @@index([userId])
  @@index([institutionId])
  @@index([date])
  @@index([type])
  @@map("activities")
}

model ActivityAttendee {
  id           String   @id @default(uuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  organization String?
  role         String?
  notes        String?
  createdAt    DateTime @default(now())

  @@map("activity_attendees")
}

// ─── PHASE 1: TRAVEL MANAGEMENT (extensions) ──────────────────────────────

model TravelItinerary {
  id                String         @id @default(uuid())
  travelRequestId   String
  travelRequest     TravelRequest  @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  type              TravelItemType
  description       String
  departureLocation String?
  arrivalLocation   String?
  date              DateTime
  cost              Float?
  confirmationRef   String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("travel_itineraries")
}

model TravelMeeting {
  id              String        @id @default(uuid())
  travelRequestId String
  travelRequest   TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  activityId      String?
  title           String
  location        String?
  date            DateTime
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("travel_meetings")
}

// ─── PHASE 1: KPI MANAGEMENT ──────────────────────────────────────────────

model ClientKPI {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  category      KPICategory
  name          String
  description   String?
  targetValue   Float
  currentValue  Float       @default(0)
  unit          String
  period        KPIPeriod
  year          Int
  month         Int?
  quarter       Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId, year])
  @@map("client_kpis")
}

// ─── PHASE 1: RISK & COMPLIANCE ───────────────────────────────────────────

model RiskRegister {
  id             String     @id @default(uuid())
  type           RiskType
  title          String
  description    String?    @db.Text
  likelihood     Int
  impact         Int
  riskScore      Int
  mitigationPlan String?    @db.Text
  status         RiskStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  marketId      String?
  market        Market?      @relation(fields: [marketId], references: [id])

  @@index([status])
  @@index([institutionId])
  @@map("risk_registers")
}

model ComplianceItem {
  id             String         @id @default(uuid())
  complianceType ComplianceType @default(OTHER)
  title          String
  description    String?        @db.Text
  status         String         @default("PENDING")
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignedToId  String?
  assignedTo    User?        @relation(fields: [assignedToId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@map("compliance_items")
}

// ─── SUCCESSION PLANNING ──────────────────────────────────────────────────

model SuccessionPlan {
  id                String   @id @default(uuid())
  employeeId        String
  employee          Employee @relation("SuccessionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  backupPersonnel   String
  crossTraining     String?  @db.Text
  emergencyCoverage String?  @db.Text
  readinessLevel    String   @default("DEVELOPING")
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeId])
  @@map("succession_plans")
}

// ─── QUARTERLY BUSINESS REVIEW ────────────────────────────────────────────

model QuarterlyBusinessReview {
  id                       String      @id @default(uuid())
  institutionId            String
  institution              Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  year                     Int
  quarter                  Int
  executiveSummary         String?     @db.Text
  marketPerformance        Json?
  roiAnalysis              Json?
  strategicRecommendations String?     @db.Text
  kpiSummary               Json?
  status                   QBRStatus   @default(DRAFT)
  pdfUrl                   String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@unique([institutionId, year, quarter])
  @@map("quarterly_business_reviews")
}
