// Illume CRM/ERM - Complete Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  HQ_EXECUTIVE
  HQ_ANALYTICS
  REGIONAL_MANAGER
  ICR
  INSTITUTION_CLIENT
  HR_MANAGER
  EMPLOYEE
  /// Spec-required client-facing role (Clients §4, Recruitment Planning §3).
  /// Owns client relationships and approves plans before client submission.
  ACCOUNT_MANAGER
  /// Spec-required application-support role (Student Pipeline §22, Clients §4).
  /// View/update application info, upload docs, record institutional updates.
  ADMISSIONS_SUPPORT
  /// Spec-required senior operational role (Recruitment Planning §3 role routing).
  /// Notified/included in Internal Final Review for quarterly plans.
  VP_GLOBAL_SALES
}

/// Recruitment pipeline position.
///
/// Declared in pipeline order deliberately: `GET /api/leads?sortBy=stage` sorts
/// by enum ordinal, so the declaration order IS the funnel order. The three
/// closed outcomes come last so they sort below the live pipeline.
enum LeadStage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  APPLICATION_SUBMITTED
  AWAITING_DECISION
  OFFER_RECEIVED
  DEPOSIT_PAID
  ENROLLED
  // Closed outcomes — reachable from any stage. The stage the lead was closed
  // from is preserved in Lead.stageBeforeClose.
  LOST
  DEFERRED
  APPLICATION_REJECTED
  /// Spec §15 — student withdrew from the process. Distinct from LOST because
  /// there was no lost-reason competition; the student pulled out unilaterally.
  WITHDRAWN
  /// Spec §15 — visa refused (only reachable when visa info is on file).
  VISA_REFUSED
}

/// Distinguishes audit rows from schedulable work.
///
/// Only ENGAGEMENT rows satisfy the pipeline's universal rule. If SYSTEM rows
/// counted, a stage change would satisfy its own gate and the inactivity
/// reminder would reset the very clock it is measuring.
enum LeadActivityKind {
  SYSTEM
  ENGAGEMENT
}

/// The per-stage "Required Tasks" from the pipeline spec, made enforceable.
/// Without types, "complete initial counselling" is satisfied by logging
/// anything at all.
enum LeadEngagementType {
  COUNSELLING
  ELIGIBILITY_REVIEW
  OFFER_REVIEW
  ENROLMENT_CONFIRMATION
  POST_OFFER_SUPPORT
  CALL
  MEETING
  EMAIL
  WHATSAPP
  FOLLOW_UP
  OTHER
}

enum LeadLostReason {
  NO_RESPONSE
  FINANCIAL
  /// "Chose Another Institution" in the spec — the student went to a rival
  /// partner of ours.
  COMPETITOR
  /// Spec §15 — chose an institution Illume does not represent (out-of-network).
  /// Distinct from COMPETITOR: we can't recruit them for another client either.
  CHOSE_NON_ILLUME
  ACADEMIC
  /// Spec §15 — didn't meet the English requirement. Distinct from ACADEMIC
  /// so language-support interventions can target it.
  ENGLISH
  VISA
  PERSONAL
  /// Spec §15 — changed study plans (e.g. deferred career, gap year, degree
  /// change). Distinct from DEFERRED (which is a stage, not a loss).
  CHANGED_PLANS
  OTHER
}

enum ApplicationSubmissionMethod {
  /// Spec §7: "University portal" — direct submission via institution's portal.
  UNIVERSITY_PORTAL
  /// Spec §7: "Agent portal" — third-party agent aggregator portal.
  AGENT_PORTAL
  EMAIL
  /// Legacy value kept for backward compatibility with existing rows;
  /// migration 019 remaps ONLINE_PORTAL → UNIVERSITY_PORTAL and AGENT → AGENT_PORTAL.
  ONLINE_PORTAL
  AGENT
  DIRECT
  /// Spec §7: "Internal admissions support" — Illume's own admissions team submits.
  INTERNAL
  OTHER
}

enum ApplicationStatus {
  SUBMITTED
  AWAITING_DECISION
  OFFER_RECEIVED
  ACCEPTED
  REJECTED
  WITHDRAWN
  /// Spec §8 "Application Statuses" (migration 037) — the INSTITUTION's
  /// position on the application, which is what the specification asks for.
  /// The six above describe OUR position and are kept because nothing in the
  /// codebase branches on any of these values and removing an enum member
  /// needs a full table rewrite.
  ///
  /// UNDER_REVIEW is its own member rather than a reuse of AWAITING_DECISION:
  /// that one is a pipeline stage name, and conflating "the institution is
  /// reviewing it" with "our stage" is the confusion this column resolves.
  UNDER_REVIEW
  ADDITIONAL_DOCUMENTS_REQUIRED
  INTERVIEW_REQUIRED
  ON_HOLD
  DECISION_DELAYED
  DECISION_RECEIVED
}

/// Result of the Qualified-stage eligibility check for an institution interest.
/// Spec §6 requires "Eligible / Provisionally Eligible / Further Information
/// Required / Not Eligible" as distinct outcomes so downstream reporting can
/// distinguish an ICR who cleared a student from one who is still gathering
/// documents.
enum EligibilityOutcome {
  ELIGIBLE
  PROVISIONALLY_ELIGIBLE
  FURTHER_INFO_REQUIRED
  NOT_ELIGIBLE
}

/// Spec §5 — outcome of the initial counselling call. Replaces the old
/// free-text `Lead.counsellingOutcome`. Making this an enum lets Contacted
/// → Qualified gate on the outcome value and lets reporting group counselling
/// results.
enum CounsellingOutcome {
  PROCEED_TO_ELIGIBILITY
  FURTHER_COUNSELLING_REQUIRED
  NOT_READY_YET
  UNABLE_TO_CONTACT
  NOT_SUITABLE
  LOST
  DEFERRED
}

/// Spec §11 — enrolment lifecycle. Replaces the previous `isConverted:Boolean`
/// which collapsed "deposit paid but never turned up" and "successfully
/// registered" into one state.
enum EnrolmentStatus {
  ENROLLED
  REGISTERED
  STARTED_STUDIES
  DID_NOT_ARRIVE
  WITHDREW_BEFORE_START
  DEFERRED_AFTER_DEPOSIT
}

/// Spec §10 — deposit payment lifecycle. Replaces the previous
/// `depositPaid:Boolean + depositDeadlineNotApplicable:Boolean` combo which
