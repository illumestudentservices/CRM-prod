// Illume CRM/ERM - Complete Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  HQ_EXECUTIVE
  HQ_ANALYTICS
  REGIONAL_MANAGER
  ICR
  INSTITUTION_CLIENT
  HR_MANAGER
  EMPLOYEE
}

/// Recruitment pipeline position.
///
/// Declared in pipeline order deliberately: `GET /api/leads?sortBy=stage` sorts
/// by enum ordinal, so the declaration order IS the funnel order. The three
/// closed outcomes come last so they sort below the live pipeline.
enum LeadStage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  APPLICATION_SUBMITTED
  AWAITING_DECISION
  OFFER_RECEIVED
  DEPOSIT_PAID
  ENROLLED
  // Closed outcomes — reachable from any stage. The stage the lead was closed
  // from is preserved in Lead.stageBeforeClose.
  LOST
  DEFERRED
  APPLICATION_REJECTED
}

/// Distinguishes audit rows from schedulable work.
///
/// Only ENGAGEMENT rows satisfy the pipeline's universal rule. If SYSTEM rows
/// counted, a stage change would satisfy its own gate and the inactivity
/// reminder would reset the very clock it is measuring.
enum LeadActivityKind {
  SYSTEM
  ENGAGEMENT
}

/// The per-stage "Required Tasks" from the pipeline spec, made enforceable.
/// Without types, "complete initial counselling" is satisfied by logging
/// anything at all.
enum LeadEngagementType {
  COUNSELLING
  ELIGIBILITY_REVIEW
  OFFER_REVIEW
  ENROLMENT_CONFIRMATION
  POST_OFFER_SUPPORT
  CALL
  MEETING
  EMAIL
  WHATSAPP
  FOLLOW_UP
  OTHER
}

