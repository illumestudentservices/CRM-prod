// ═══════════════════════════════════════════════════════════════════════════
// REDESIGN MODELS (Phases 2–6)
//
// Everything below is net-new against the pre-redesign schema. Existing
// models above stay in place so line numbers are stable for other work.
// Phases 2, 4, 5, 6 own the new tables; migrations 013–017 create them.
//
// SPEC RENAMES DEFERRED:
//   Source → RecruitmentPartner: schema keeps `Source` for continuity because
//   Prisma auto-derives relation field names (`lead.source`, `activity.source`)
//   that would ripple through ~40 call sites on rename. A codebase-wide
//   symbol rename is scheduled after the Phase 2 cutover.
//   Activity → FieldOperation: same reasoning; @@map("activities") preserves
//   the table, code migration is Phase 3.5.
// ═══════════════════════════════════════════════════════════════════════════

// ─── PHASE 2: RECRUITMENT NETWORK ─────────────────────────────────────────

/// Spec §3–4 Stakeholders retirement + Spec §5 Contact-under-parent.
///
/// Every counsellor, agent owner, agent branch manager, referral-partner
/// point of contact — all one entity today, all one model here. Migration 013
/// copies `Counsellor` rows into this table (partnerId = the source row of
/// type SCHOOL that the counsellor's school maps to) and marks the old table
/// for drop in a later phase.
///
/// InstitutionContact is a peer, not a superset: it serves university-side
/// stakeholders (director of international, admissions manager) which is a
/// genuinely different domain.
model PartnerContact {
  id        String  @id @default(uuid())
  partnerId String
  partner   RecruitmentPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  fullName    String
  position    String?
  role        String? /// COUNSELLOR / OWNER / BRANCH_MANAGER / SENIOR_COUNSELLOR / ADVISOR / OTHER
  email       String?
  phone       String?
  isPrimary   Boolean @default(false)
  isActive    Boolean @default(true)
  notes       String? @db.Text

  /// Populated when migrated from the retiring `Counsellor` model, so a row
  /// can be traced back if the migration needs auditing.
  legacyCounsellorId String? @unique

  lastEngagementDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
  @@index([email])
  @@map("partner_contacts")
}

/// Spec §7 (Recruitment Network / Events) — participation is a first-class
/// record so one Recruitment Event supports N institutions with their own
/// assigned ICR, participation status and outcome notes. Replaces the join
/// row semantics of `EventInstitution` with explicit per-institution state.
///
/// Migration 013 backfills from existing `EventInstitution` rows so nothing
/// on the old-style events pages breaks.
model EventParticipation {
  id            String @id @default(uuid())
  eventId       String
  event         Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  assignedICRId String?
  assignedICR   User?   @relation("EventParticipationICR", fields: [assignedICRId], references: [id])

  status                    String @default("CONFIRMED") /// INVITED / CONFIRMED / DECLINED / ATTENDED / NO_SHOW
  attendanceConfirmed       Boolean @default(false)
  activitySummary           String? @db.Text
  institutionOutcomeNotes   String? @db.Text
  participationCost         Float?
  participationCostCurrency String? @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, institutionId])
  @@index([assignedICRId])
  @@map("event_participations")
}

// ─── PHASE 4: RECRUITMENT PLANNING ────────────────────────────────────────

/// Spec §1 — one plan per ICR per client assignment per quarter (unless
/// multiple assignments are consolidated into one approved regional plan).
///
/// Owns the request-and-approval flow. Once APPROVED it becomes read-only;
/// further changes go through a VariationRequest.
model QuarterlyRecruitmentPlan {
  id             String                @id @default(uuid())
  icrId          String
  icr            User                  @relation("PlanICR", fields: [icrId], references: [id])
  institutionId  String?
  institution    Institution?          @relation(fields: [institutionId], references: [id])
  marketId       String?
  market         Market?               @relation(fields: [marketId], references: [id])
  quarter        Int /// 1..4
  year           Int
  reportingCurrency String              @default("USD")

  status         RecruitmentPlanStatus @default(DRAFT)

  // ─── Approval routing (spec §3) ────────────────────────────────────────
  /// These three record WHO performed each routing step. They are stamped by
  /// the transition route from the acting user, not assigned up front.
  /// All three sat permanently null until 2026-08-13: the `*ReviewedAt`
  /// timestamps were being written while these stayed empty, so a plan showed
  /// that a review had happened but never by whom.
  regionalManagerId     String?
  regionalManager       User?     @relation("PlanRegionalManager", fields: [regionalManagerId], references: [id])
  regionalReviewedAt    DateTime?
  regionalReviewNotes   String?   @db.Text

  accountManagerId      String?
  accountManager        User?     @relation("PlanAccountManager", fields: [accountManagerId], references: [id])
  accountReviewedAt     DateTime?
  accountReviewNotes    String?   @db.Text

  /// The VP_GLOBAL_SALES — or HQ_EXECUTIVE — who cleared Internal Final Review.
  /// This was previously documented as "VP Global Sales is mapped to
  /// HQ_EXECUTIVE for now (decision #5)". That interim mapping is retired:
  /// VP_GLOBAL_SALES now exists as a real role and holds the step, with
  /// HQ_EXECUTIVE kept alongside it because spec §3 says the VP is *included in*
  /// this review rather than its sole owner.
  vpReviewerId          String?
  vpReviewer            User?     @relation("PlanVpReviewer", fields: [vpReviewerId], references: [id])
  internalFinalReviewedAt DateTime?
  internalFinalReviewNotes String? @db.Text

  clientReviewedAt      DateTime?
  clientReviewNotes     String?   @db.Text

  approvedAt            DateTime?
  activatedAt           DateTime?
  completedAt           DateTime?
  closedAt              DateTime?

  // ─── Objectives (spec §4E) ─────────────────────────────────────────────
  objectives            Json?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  plannedTravel        PlannedTravel[]
  plannedEvents        PlannedEventParticipation[]
  plannedFieldActivities PlannedFieldActivity[]
  budgetItems          RecruitmentPlanBudgetItem[]
  variationRequests    VariationRequest[]

  @@unique([icrId, institutionId, quarter, year])
  @@index([status])
  @@index([quarter, year])
  @@map("quarterly_recruitment_plans")
}

/// Spec §4A — planned travel. When the parent plan is approved, corresponding
/// active TravelRecord rows should be created via the API; this table stores
/// the request state.
model PlannedTravel {
  id           String @id @default(uuid())
  planId       String
  plan         QuarterlyRecruitmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  destination  String
  country      String
  city         String?
  plannedStart DateTime
  plannedEnd   DateTime
  purpose      String  @db.Text
  linkedEventId String?
  linkedEvent   Event?  @relation(fields: [linkedEventId], references: [id])

  estimatedCost         Float?
  estimatedCurrency     String? @default("USD")

  /// Set true when the parent plan reaches APPROVED — Travel API creates a
  /// real TravelRequest and stamps the FK back.
  activatedAt          DateTime?
  activatedTravelRequestId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@map("planned_travel")
}

/// Spec §4B — participation request against a master Recruitment Event. Does
/// NOT create a new Event; if the event doesn't exist, the ICR proposes a
/// new master Event first (status = PROPOSED) and this row references it.
model PlannedEventParticipation {
  id           String @id @default(uuid())
  planId       String
  plan         QuarterlyRecruitmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event  @relation(fields: [eventId], references: [id])

  institutionRepresentedId String
  institutionRepresented   Institution @relation(fields: [institutionRepresentedId], references: [id])

  purpose                String? @db.Text
  estimatedCost          Float?
  estimatedCurrency      String? @default("USD")
  expectedLeads          Int?
  expectedApplications   Int?
  expectedEnrolments     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([eventId])
  @@map("planned_event_participations")
}

/// Spec §4C — planned quantities per activity type. Detailed scheduling
/// happens later in Field Operations against these targets.
model PlannedFieldActivity {
  id             String @id @default(uuid())
  planId         String
  plan           QuarterlyRecruitmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  activityType   String /// SCHOOL_VISIT / AGENT_MEETING / COUNSELLOR_TRAINING / STUDENT_PRESENTATION / WEBINAR / CLIENT_MEETING / OTHER
  plannedCount   Int
  actualCount    Int    @default(0)
  notes          String? @db.Text
  /// Spec §7 — set once the plan activation cron materialises a stub
  /// Field Operation row for this planned activity. Prevents double-creation
  /// on re-runs.
  activatedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@map("planned_field_activities")
}

/// Spec §4D + §10 — every line item carries original currency, converted
/// currency and the rate used, so quarterly reconciliation is auditable.
/// FX rates are ENTERED, not fetched — see decision #6.
model RecruitmentPlanBudgetItem {
  id                   String  @id @default(uuid())
  planId               String
  plan                 QuarterlyRecruitmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  category             String /// FLIGHTS / ACCOMMODATION / LOCAL_TRANSPORT / EVENT_REGISTRATION / MARKETING_MATERIALS / MEALS / MISCELLANEOUS
  description          String?

  amount               Float
  currency             String
  convertedAmount      Float?
  reportingCurrency    String?
  exchangeRate         Float?
  exchangeRateDate     DateTime?
  exchangeRateSource   String? /// free-text audit note e.g. "Bank of Baroda TT rate 2026-Q3-01"

  approvedAmount       Float?
  actualSpend          Float?

  /// Spec §4D — cost allocation category. Prevents double-counting when the
  /// same event registration lands in both a shared event cost and a
  /// participation cost.
  allocation           String @default("PLAN") /// SHARED_EVENT / INSTITUTION_PARTICIPATION / ICR_TRAVEL / GENERAL_ACTIVITY / PLAN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@map("recruitment_plan_budget_items")
}

/// Spec §9 — approved plans are read-only; any change is a VariationRequest.
/// Types are enumerated so the approval route can escalate on budget
/// increases without escalating on scope reductions.
model VariationRequest {
  id           String        @id @default(uuid())
  planId       String
  plan         QuarterlyRecruitmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  type         VariationType
  reason       String        @db.Text
  requestedById String
  requestedBy   User         @relation("VariationRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime     @default(now())

  status        RecruitmentPlanStatus @default(SUBMITTED)
  approvedById  String?
  approvedBy    User?        @relation("VariationApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  reviewNotes   String?      @db.Text

  /// Where a variation adds cost, this is the incremental request in the
  /// plan's reporting currency. The API keeps the split-currency detail in
  /// linked budget items if needed.
  incrementalCost Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@map("variation_requests")
}

// ─── PHASE 5: MARKET INTELLIGENCE ──────────────────────────────────────────

/// Spec §7 — ICRs suggest, RMs approve. This model captures the suggestion
/// with its original + reviewed content so an edit doesn't overwrite the
/// submitter's words.
model MarketUpdateSuggestion {
  id           String @id @default(uuid())
  marketId     String
  market       Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  kind         MarketUpdateKind
  originalText String @db.Text
  editedText   String? @db.Text

  submittedById String
  submittedBy   User   @relation("MarketUpdateSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  status        MarketUpdateStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?    @relation("MarketUpdateReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNotes   String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId, status])
  @@index([submittedById])
  @@map("market_update_suggestions")
}

// ─── PHASE 6: TASKS WORKFLOW ENGINE ────────────────────────────────────────

/// Spec §16 — reusable task recipe. Instances are created via API when
/// events fire (e.g. "student application submitted" → create the three
/// document-request tasks from the SCHOOL_VISIT template).
model TaskTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text

  /// The trigger that generates instances from this template. Machine-readable
  /// event name checked by the workflow layer, e.g. "STUDENT_APPLICATION_SUBMITTED".
  triggerEvent String?

  /// Which parent type the generated tasks are linked to.
  parentType   TaskParentType?
  category     TaskCategory    @default(OTHER)

  /// Recurring cadence for templates that fire on a schedule instead of an
  /// event (e.g. "submit monthly report" every 1st of the month).
  recurrence   TaskRecurrence  @default(ONE_OFF)

  /// Ordered set of task specs generated when the template fires.
  /// Shape: [{title, description?, offsetDays?, priority?}, ...].
  itemsJson    Json

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks Task[]

  @@map("task_templates")
}

// ─── Polymorphic attachments (Phase 8, migration 022) ─────────────────────
//
// Rather than a new attachment table for every module that needs one, a
// single `attachments` row can belong to any parent record via
// (parentType, parentId). Existing purpose-built tables stay in place
// (KnowledgeBaseAttachment, ContractAttachment, LeadDocument,
// InstitutionDocument, EmployeeDocument) — this is additive for the
// modules that didn't have one.
//
// Security posture: every upload goes through lib/attachment-safety.ts
// (validateAttachment) — same MIME + filename allowlist as the H-4 fix.
// Downloads use safeAttachmentHeaders so a stored bad row can't be served
// as HTML/SVG.

enum AttachmentParentType {
  TASK
  ACTIVITY
  CLIENT_ISSUE
  RECRUITMENT_EVENT
  MARKETING_CAMPAIGN
  RECRUITMENT_PARTNER
  MARKET_UPDATE_SUGGESTION
  RECRUITMENT_PLAN
  VARIATION_REQUEST
  MONTHLY_REPORT
  /// §7 of the ICR report template — event / school-visit / partner-meeting
  /// snapshots attached to the rep's monthly report.
  ICR_MONTHLY_REPORT
  ENGAGEMENT_LOG
  LEAD_NOTE
  LEAD
  INSTITUTION_INTEREST
  RISK_REGISTER
  COMPLIANCE_ITEM
  ACCOUNT_INTERVENTION
  QUARTERLY_BUSINESS_REVIEW
}

model Attachment {
  id           String               @id @default(uuid())
  /// Which module the attachment belongs to. Together with parentId this
  /// forms a polymorphic foreign key — the referenced row lives in whichever
  /// table this enum names.
  parentType   AttachmentParentType
  /// FK-less parent reference. Each parent-owning API route validates that
  /// the referenced row actually exists and that the caller can access it,
  /// so a broken parentId can't create an orphan attachment.
  parentId     String
  name         String
  mimeType     String
  size         Int
  data         Bytes
  /// Author of the upload; used for audit + display. Nullable to survive
  /// user soft-delete without losing the file itself.
  uploadedById String?
  uploadedBy   User?                @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  /// Recycle-bin support. Set by lib/recycle-bin.trashRecord; nullified on
  /// restore. The 60-day purge cron hard-deletes rows where deletedAt is old.
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?                @relation("AttachmentDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([parentType, parentId])
  @@index([uploadedById])
  @@map("attachments")
}

// ─── PHASE 9: RECYCLE BIN ─────────────────────────────────────────────────

/// System-wide recycle bin. Every DELETE endpoint routes through
/// lib/recycle-bin.trashRecord(), which writes a row here before either
/// setting deletedAt on the target (for soft-delete-capable entities) or
/// snapshotting the row to `data` and hard-deleting it. A daily cron purges
/// anything past expiresAt (60-day retention).
model DeletedRecord {
  id            String   @id @default(uuid())
  /// Discriminator used to look up the entity in lib/recycle-bin's registry.
  /// e.g. "Lead", "Attachment", "ClientKPI".
  entityType    String
  /// Original primary key of the deleted row. For hard-delete entities this
  /// is only meaningful as an audit reference; for soft-delete entities it
  /// still points at a real row that's been marked deletedAt.
  entityId      String
  /// Rendered display label for the item ("Passport.pdf", "Aisha Diallo",
  /// "Q3 KPI: enrolments"). Used in the recycle-bin UI so admins can find
  /// what they need without loading each entity.
  entityLabel   String
  /// Human context — the row's owner. Optional because top-level entities
  /// (institutions, users) don't have a natural parent.
  parentType    String?
  parentId      String?
  parentLabel   String?
  /// True if the delete actually removed the row from its table (data
  /// snapshot must be non-null in that case). False if the row still exists
  /// with deletedAt set (data is null; restore just clears deletedAt).
  hardDeleted   Boolean
  /// Full row snapshot for hard-delete restore. Prisma's Json type serialises
  /// bigints/dates as strings — the restore path converts them back using
  /// the model shape.
  data          Json?

  deletedById   String?
  deletedBy     User?     @relation("DeletedRecordDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedAt     DateTime  @default(now())
  /// Materialised deletedAt + 60 days. The purge cron indexes this so it
  /// runs as a single-index scan.
  expiresAt     DateTime
  /// Set when an admin restores the item. Non-null means this row is a
  /// historical activity record, not a live bin entry.
  restoredAt    DateTime?
  restoredById  String?
  restoredBy    User?     @relation("DeletedRecordRestorer", fields: [restoredById], references: [id], onDelete: SetNull)
  /// Set when the item is permanently deleted (either by the cron or by
  /// admin action). Same semantics as restoredAt for indexing.
  purgedAt      DateTime?

  @@index([expiresAt])
  @@index([entityType, entityId])
  @@index([deletedById])
  @@index([deletedAt(sort: Desc)])
  @@map("deleted_records")
}

// ─── PHASE 10: GRANULAR PERMISSIONS ───────────────────────────────────────

/// What a GranularPermission row is talking about.
///
/// The existing PermissionOverride table already covers resource × action
/// ("leads:write"). These two scopes sit *below* that and are only consulted
/// once the coarse action check has passed — they can narrow access, never
/// widen it.
enum PermissionScope {
  /// A named operation finer than an action, e.g. "leads.merge" or
  /// "leads.export_pii". Lets you grant `leads:write` while withholding the
  /// destructive or sensitive subset of it.
  CAPABILITY
  /// A single column, e.g. leads.passportNumber. Carries an access mode so
  /// read and write can be granted independently — the common case is
  /// "may see it, may not change it".
  FIELD
}

/// Role-level grant or revoke for one capability or one field.
///
/// Absence of a row means "use the registry default" — the table only stores
/// deviations, which keeps it small and makes "reset to defaults" a delete.
model GranularPermission {
  id       String          @id @default(uuid())
  role     Role
  scope    PermissionScope
  /// Owning resource key, matching lib/permissions Resource ("leads").
  resource String
  /// Capability key for CAPABILITY, column name for FIELD.
  target   String
  /// "read" | "write" for FIELD. Null for CAPABILITY, which is binary.
  access   String?
  granted  Boolean

  updatedAt   DateTime @updatedAt
  updatedById String

  /// access is part of the key so a field can carry separate read and write
  /// rows. Postgres treats NULLs as distinct in a unique index, so CAPABILITY
  /// rows (access = null) are deduplicated by the partial index in the
  /// migration rather than by this constraint.
  @@unique([role, scope, resource, target, access])
  @@index([role, scope])
  @@map("granular_permissions")
}

// ─── ICR Transition & Handover ───────────────────────────────────────────────
//
// A structured handover produced when an ICR stops covering an assignment.
//
// The governing rule from the spec is that this "must not become another
// database containing copies of information already in the CRM". So these
// models store three things and nothing else: the assignment being handed over,
// the outgoing ICR's commentary, and — only once the report is Final — a frozen
// snapshot of what the linked records looked like at that moment. Students,
// agents, tasks, plans and forecasts stay owned by their own modules and are
// read live until finalisation.

/// Why the assignment is ending. Spec §6.
enum TransitionType {
  LEAVING_ILLUME
  INSTITUTION_REASSIGNMENT
  MARKET_REASSIGNMENT
  INTERNAL_ROLE_CHANGE
  TEMPORARY_COVERAGE
  EXTENDED_LEAVE
  OTHER
}

/// Spec §5. Declared in workflow order: RESUBMITTED re-enters review after
/// AMENDMENTS_REQUIRED, so the sequence is not strictly linear.
enum TransitionStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED_TO_RM
  AMENDMENTS_REQUIRED
  RESUBMITTED
  ACCEPTED_BY_RM
  FINAL
  ARCHIVED
}

/// The fifteen report sections, spec §8–§23, in the order they are presented.
enum TransitionSectionKey {
  EXECUTIVE_HANDOVER_SUMMARY
  MARKET_OVERVIEW
  RECRUITMENT_EVENTS_ACTIVITIES
  PRIORITY_AGENT_HANDOVER
  NEW_HIGH_POTENTIAL_AGENTS
  SCHOOL_INSTITUTION_RELATIONSHIPS
  OTHER_KEY_RELATIONSHIPS
  ACTIVE_STUDENT_PIPELINE
  OUTSTANDING_TASKS_COMMITMENTS
  RECRUITMENT_PLAN_TRAVEL_BUDGET
  CURRENT_FORECAST
  CLIENT_OPERATIONAL_KNOWLEDGE
  OUTSTANDING_ISSUES_RISKS
  KEY_DOCUMENTS_RESOURCES
  FINAL_STRATEGIC_RECOMMENDATIONS
}

model TransitionReport {
  id String @id @default(uuid())

  /// Scope. Spec §7 is explicit that a report belongs to an ASSIGNMENT, not to
  /// a person: an ICR covering Institution A and B who stops covering only A
  /// must produce a report containing A's pipeline and nothing of B's. The
  /// institution is therefore required, and every section query is filtered by
  /// it rather than by outgoingIcrId alone.
  outgoingIcrId String
  outgoingIcr   User   @relation("TransitionOutgoingICR", fields: [outgoingIcrId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  markets TransitionReportMarket[]

  /// Incoming ICR is optional: a departure is often assigned before a
  /// replacement is known, and the spec lists it as "where known".
  incomingIcrId String?
  incomingIcr   User?   @relation("TransitionIncomingICR", fields: [incomingIcrId], references: [id])

  regionalManagerId String
  regionalManager   User   @relation("TransitionRegionalManager", fields: [regionalManagerId], references: [id])

  clientRelationsDirectorId String?
  clientRelationsDirector   User?   @relation("TransitionClientRelations", fields: [clientRelationsDirectorId], references: [id])

  vpGlobalSalesId String?
  vpGlobalSales   User?   @relation("TransitionVpGlobalSales", fields: [vpGlobalSalesId], references: [id])

  transitionType          TransitionType
  effectiveTransitionDate DateTime
  /// Only meaningful for LEAVING_ILLUME and similar; nullable by design.
  finalWorkingDay         DateTime?
  reportDueDate           DateTime

  status TransitionStatus @default(ASSIGNED)

  /// Spec §24. The report cannot be submitted until the outgoing ICR confirms
  /// the declaration, so this is recorded rather than inferred from status.
  declarationConfirmedAt DateTime?
  declarationById        String?

  submittedAt DateTime?
  acceptedAt  DateTime?
  finalisedAt DateTime?
  archivedAt  DateTime?

  /// Spec §37. Written once, when the report becomes Final. Until then it is
  /// null and every figure is read live. A student at Offer Received on the
  /// handover date must still read Offer Received here after they enrol.
  snapshot   Json?
  snapshotAt DateTime?

  createdById String
  createdBy   User   @relation("TransitionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections TransitionReportSection[]
  events   TransitionWorkflowEvent[]

  /// One live report per ICR per institution. A second handover for the same
  /// assignment means the first is Archived, not duplicated.
  @@index([outgoingIcrId, institutionId])
  @@index([status])
  @@index([regionalManagerId])
  @@index([reportDueDate])
  @@map("transition_reports")
}

/// Markets covered by the assignment. A join table rather than a String[] so a
/// deleted market cannot leave an unresolvable id behind in the report scope.
model TransitionReportMarket {
  reportId String
  report   TransitionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  marketId String
  market   Market           @relation(fields: [marketId], references: [id])

  @@id([reportId, marketId])
  @@index([marketId])
  @@map("transition_report_markets")
}

/// One row per section per report.
///
/// A single table keyed by an enum rather than fifteen tables: the sections
/// differ in what they ASK, not in what they store — CRM context is read live
/// from the owning module, and what the ICR adds is narrative plus a handful of
/// structured answers. Fifteen near-identical tables would make "is every
/// required section complete?" a fifteen-way join.
model TransitionReportSection {
  id       String           @id @default(uuid())
  reportId String
  report   TransitionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  section TransitionSectionKey

  /// The outgoing ICR's commentary for this section.
  narrative String? @db.Text

  /// Structured answers that vary by section (priority lists, ratings,
  /// per-agent commentary). Json because the shape is section-specific and
  /// validated in application code against the section key.
  data Json?

  /// Set when the ICR marks the section done. Submission validation (spec §33)
  /// checks this rather than inspecting narrative length.
  completedAt   DateTime?
  completedById String?

  updatedAt DateTime @updatedAt

  @@unique([reportId, section])
  @@map("transition_report_sections")
}

/// Spec §5: "Full workflow history must be retained." Append-only; rows are
/// never updated, so the trail cannot be rewritten by a later transition.
model TransitionWorkflowEvent {
  id       String           @id @default(uuid())
  reportId String
  report   TransitionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  fromStatus TransitionStatus?
  toStatus   TransitionStatus

  actedById String
  actedBy   User   @relation(fields: [actedById], references: [id])

  /// Required when returning a report for amendments, so the ICR is told why.
  comments String? @db.Text

  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
  @@map("transition_workflow_events")
}

// ─── Forecasting ─────────────────────────────────────────────────────────────
//
// Replaces the RM Master Aggregation spreadsheet. The spec's governing idea is
// a division of labour: "CRM provides the facts. ICR provides the forecast
// judgement. RM provides regional oversight." So the pipeline figures are NOT
// stored here — spec §5 says they are "system-generated and should not be
// manually editable from Forecasting" — they are computed live from the leads
// and interests that own them. What persists is judgement: the ICR's numbers,
// the RM's numbers, and why.

/// Spec §3. Every forecast is broken into these four segments; the total is
/// derived, never entered.
enum ForecastSegmentKey {
  DIRECT_UG
  DIRECT_PG
  INDIRECT_UG
  INDIRECT_PG
}

/// Spec §11–§18, in workflow order.
enum ForecastStatus {
  DRAFT
  SUBMITTED_TO_RM
  RETURNED_TO_ICR
  RM_REVIEWED
  REGIONAL_SUBMITTED
  RETURNED_TO_RM
  ACCEPTED
  ARCHIVED
}

/// Spec §10. System-assessed, distinct from the ICR's confidence score: one is
/// where the pipeline actually sits, the other is what the ICR believes.
enum PipelineMaturity {
  EARLY_STAGE
  PIPELINE_DEPENDENT
  MODERATE_MATURITY
  HIGH_MATURITY
}

model Forecast {
  id String @id @default(uuid())

  /// Spec §3: "Forecast Period + Institution + Market + ICR + Intake" is the
  /// minimum identity of a forecast, so all five are part of the unique key.
  periodYear  Int
  periodMonth Int

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  marketId String?
  market   Market? @relation(fields: [marketId], references: [id])

  icrId String
  icr   User   @relation("ForecastICR", fields: [icrId], references: [id])

  /// The intake being forecast, which is not the period the forecast is made in.
  intakeYear  Int
  intakeMonth Int

  status ForecastStatus @default(DRAFT)

  /// Spec §10. 1–5, the ICR's own confidence. Nullable until they enter it;
  /// submission requires it.
  confidenceScore Int?

  /// Spec §10. Written when the forecast is submitted, so the maturity recorded
  /// is the one that applied at the time rather than whatever the pipeline
  /// looks like when someone opens it months later.
  pipelineMaturity PipelineMaturity?

  /// Spec §9. Required to submit — a number with no reasoning cannot be
  /// reviewed, only accepted or rejected on faith.
  rationale       String? @db.Text
  keyRisks        String? @db.Text
  keyOpportunities String? @db.Text

  regionalManagerId String?
  regionalManager   User?   @relation("ForecastRM", fields: [regionalManagerId], references: [id])
  /// Spec §13: when the RM adjusts, they must say why. The ICR's number stays.
  rmComment         String? @db.Text

  vpReviewerId String?
  vpReviewer   User?   @relation("ForecastVP", fields: [vpReviewerId], references: [id])
  vpComment    String? @db.Text

  submittedAt DateTime?
  rmReviewedAt DateTime?
  regionalSubmittedAt DateTime?
  acceptedAt  DateTime?

  /// Spec §30/§31. Written once the intake is known, so accuracy can be
  /// measured against what was actually accepted rather than recomputed from a
  /// pipeline that has moved on.
  actualEnrolments Int?
  actualsRecordedAt DateTime?

  createdById String
  createdBy   User   @relation("ForecastCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments ForecastSegment[]
  events   ForecastEvent[]

  /// One forecast per ICR per institution per intake per period. Two would make
  /// "what did we forecast in March" unanswerable.
  @@unique([periodYear, periodMonth, institutionId, icrId, intakeYear, intakeMonth])
  @@index([status])
  @@index([icrId, status])
  @@index([regionalManagerId, status])
  @@map("forecasts")
}

/// Spec §6 and §13. One row per segment, holding BOTH judgements.
///
/// The ICR and RM columns are separate rather than one mutated set because §13
/// is explicit: "RM adjustments must create separate RM forecast values rather
/// than overwriting the ICR submission… The historical record should therefore
/// show both professional judgements." Overwriting would destroy the only data
/// that makes forecast-accuracy analysis per person possible.
model ForecastSegment {
  id         String   @id @default(uuid())
  forecastId String
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  segment ForecastSegmentKey

  /// The ICR's submitted judgement (spec §6).
  icrApplications Int @default(0)
  icrDeposits     Int @default(0)
  icrEnrolments   Int @default(0)

  /// The RM's adjustment, null when they agree. Null is meaningful here: it
  /// says "not adjusted", which is different from "adjusted to the same value".
  rmApplications Int?
  rmDeposits     Int?
  rmEnrolments   Int?

  updatedAt DateTime @updatedAt

  @@unique([forecastId, segment])
  @@map("forecast_segments")
}

/// Spec §35. Append-only workflow trail; rows are never updated, so a later
/// cycle cannot rewrite an earlier one.
model ForecastEvent {
  id         String   @id @default(uuid())
  forecastId String
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  fromStatus ForecastStatus?
  toStatus   ForecastStatus

  actedById String
  actedBy   User   @relation(fields: [actedById], references: [id])

  comments String? @db.Text

  createdAt DateTime @default(now())

  @@index([forecastId, createdAt])
  @@map("forecast_events")
}
