// ─── PHASE 1: ACTIVITY MANAGEMENT ─────────────────────────────────────────

/// Spec §1 (Field Operations) — "the module should manage the work performed
/// by Illume, not simply record random activities. Every Field Operation must
/// relate to one or more CRM entities."
///
/// Spec §3 — activity lifecycle: Planned → In Progress → Completed → Closed.
/// Completed = happened. Closed = outcome recorded + follow-up assigned.
model Activity {
  id                    String       @id @default(uuid())
  type                  ActivityType
  /// Spec §3 (Field Operations) — lifecycle state. Nullable during rollout so
  /// existing rows survive; migration 019 backfills based on `endDate` /
  /// `outcomes` heuristics.
  status                ActivityStatus?
  /// Spec §2 (Field Operations) — provenance relative to the approved plan.
  planAlignment         FieldWorkPlanAlignment?
  title                 String
  description           String?      @db.Text
  date                  DateTime
  endDate               DateTime?
  /// Spec §8 — captured when the activity is marked Completed. `endDate` was
  /// used as a proxy but was inconsistent; this is the authoritative field.
  actualDate            DateTime?
  outcomeSummary        String?      @db.Text
  /// Spec §8 — follow-up capture is required when status transitions to CLOSED
  /// via the standard flow.
  followUpRequired      Boolean      @default(false)
  followUpDescription   String?      @db.Text
  followUpDueDate       DateTime?
  followUpAssigneeId    String?
  followUpAssignee      User?        @relation("ActivityFollowUpAssignee", fields: [followUpAssigneeId], references: [id])
  location              String?
  city                  String?
  country               String?
  /// DEPRECATED — these counts should come from the linked Lead/Interest
  /// records, not manual entry. Retained so old rows still open; new UI hides
  /// them from the form.
  studentsEngaged       Int?
  counsellorsEngaged    Int?
  leadsGenerated        Int?
  applicationsGenerated Int?
  cost                  Float?
  roi                   Float?
  outcomes              String?      @db.Text
  followUp              String?      @db.Text
  actionItems           Json?
  topics                String?      @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  userId        String
  user          User         @relation(fields: [userId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  marketId      String?
  market        Market?      @relation(fields: [marketId], references: [id])
  schoolId      String?
  school        School?      @relation("ActivitySchool", fields: [schoolId], references: [id])
  sourceId      String?
  source        RecruitmentPartner? @relation("ActivitySource", fields: [sourceId], references: [id])
  /// Spec §7 (Field Operations) — multi-entity linking. Activity → Student
  /// where applicable (student follow-up sessions, offer discussions).
  leadId        String?
  lead          Lead?        @relation("ActivityLead", fields: [leadId], references: [id])
  /// Spec §7 (Field Operations) — activity linked to a marketing campaign.
  campaignId    String?
  campaign      Campaign?    @relation("ActivityCampaign", fields: [campaignId], references: [id])
  /// Spec §7 (Field Operations) — activity linked to a recruitment event
  /// (event-preparation / event-follow-up work).
  eventId       String?
  event         Event?       @relation("ActivityEvent", fields: [eventId], references: [id])

  attendees ActivityAttendee[]
  tasks     Task[]
  /// Spec §10 (Clients) — evidence documents (photos, agenda, minutes).
  documents InstitutionDocument[] @relation("DocumentActivity")

  @@index([userId])
  @@index([institutionId])
  @@index([date])
  @@index([type])
  @@index([status])
  @@index([leadId])
  @@index([campaignId])
  @@index([eventId])
  @@map("activities")
}

